          "_anchor": "menu06-f",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "P": {
              "color": "#b8c9d3"
            },
            "H2": {
              "color": "#232323"
            }
          },
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "\r\n<style>\r\n/* REGKINGS PHARMACY PAGE */\r\n.regkings {\r\n  --rk-navy: #071b2b;\r\n  --rk-green: #20c878;\r\n  --rk-light: #f4f8f6;\r\n  --rk-muted: #b8c9d3;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n  color: var(--rk-light);\r\n  background: var(--rk-navy);\r\n  line-height: 1.7;\r\n  overflow: hidden;\r\n}\r\n\r\n.regkings * {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.regkings a {\r\n  text-decoration: none;\r\n}\r\n\r\n.regkings .rk-container {\r\n  width: 92%;\r\n  max-width: 1180px;\r\n  margin: auto;\r\n}\r\n\r\n/* BUTTONS */\r\n.regkings .rk-btn {\r\n  display: inline-block;\r\n  background: var(--rk-green);\r\n  color: #061b2b;\r\n  font-weight: 700;\r\n  padding: 13px 23px;\r\n  border-radius: 6px;\r\n  transition: .25s;\r\n}\r\n\r\n.regkings .rk-btn:hover {\r\n  background: #43e394;\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.regkings .rk-btn-outline {\r\n  display: inline-block;\r\n  color: #fff;\r\n  border: 1px solid #6b8796;\r\n  padding: 12px 22px;\r\n  border-radius: 6px;\r\n  transition: .25s;\r\n}\r\n\r\n.regkings .rk-btn-outline:hover {\r\n  border-color: var(--rk-green);\r\n  color: var(--rk-green);\r\n}\r\n\r\n/* HERO */\r\n.regkings .rk-hero {\r\n  padding: 95px 0;\r\n  background:\r\n    radial-gradient(ellipse at 85% 30%, rgba(32,200,120,.15), transparent 42%),\r\n    linear-gradient(135deg, #071b2b 0%, #0b293b 100%);\r\n}\r\n\r\n.regkings .rk-hero-grid {\r\n  display: grid;\r\n  grid-template-columns: 1.2fr .8fr;\r\n  align-items: center;\r\n  gap: 55px;\r\n}\r\n\r\n.regkings .rk-eyebrow {\r\n  color: var(--rk-green);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 3px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.regkings .rk-hero h1 {\r\n  color: #fff;\r\n  font-size: clamp(38px, 5vw, 61px);\r\n  line-height: 1.12;\r\n  margin: 18px 0;\r\n}\r\n\r\n.regkings .rk-hero h1 span {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-hero p {\r\n  color: var(--rk-muted);\r\n  font-size: 16px;\r\n  max-width: 590px;\r\n  margin-bottom: 28px;\r\n}\r\n\r\n.regkings .rk-hero-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 13px;\r\n}\r\n\r\n.regkings .rk-hero-card {\r\n  background: rgba(255,255,255,.045);\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  padding: 32px;\r\n  border-radius: 16px;\r\n  box-shadow: 0 18px 45px rgba(0,0,0,.18);\r\n}\r\n\r\n.regkings .rk-hero-icon {\r\n  width: 75px;\r\n  height: 75px;\r\n  border-radius: 18px;\r\n  background: rgba(32,200,120,.12);\r\n  border: 1px solid rgba(32,200,120,.3);\r\n  display: grid;\r\n  place-items: center;\r\n  color: var(--rk-green);\r\n  font-size: 38px;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.regkings .rk-hero-card h3 {\r\n  color: #fff;\r\n  font-size: 23px;\r\n  margin: 0 0 12px;\r\n}\r\n\r\n.regkings .rk-hero-card p {\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n/* SECTION HEADINGS */\r\n.regkings .rk-section {\r\n  padding: 78px 0;\r\n}\r\n\r\n.regkings .rk-section-light {\r\n  background: #f4f8f6;\r\n  color: #102b3b;\r\n}\r\n\r\n.regkings .rk-heading {\r\n  max-width: 700px;\r\n  margin: 0 auto 42px;\r\n  text-align: center;\r\n}\r\n\r\n.regkings .rk-heading .rk-eyebrow {\r\n  display: block;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.regkings .rk-heading h2 {\r\n  font-size: clamp(28px, 4vw, 40px);\r\n  line-height: 1.2;\r\n  margin: 0 0 14px;\r\n}\r\n\r\n.regkings .rk-heading p {\r\n  color: #6a7c86;\r\n  margin: 0;\r\n}\r\n\r\n/* CATEGORY CARDS */\r\n.regkings .rk-categories {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 22px;\r\n}\r\n\r\n.regkings .rk-category {\r\n  background: #fff;\r\n  border: 1px solid #e0e9e4;\r\n  border-radius: 12px;\r\n  padding: 28px;\r\n  transition: transform .25s, box-shadow .25s;\r\n}\r\n\r\n.regkings .rk-category:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 15px 35px rgba(9,40,30,.09);\r\n}\r\n\r\n.regkings .rk-category-icon {\r\n  width: 58px;\r\n  height: 58px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 12px;\r\n  background: #e5f8ee;\r\n  font-size: 28px;\r\n  margin-bottom: 19px;\r\n}\r\n\r\n.regkings .rk-category h3 {\r\n  color: #102b3b;\r\n  font-size: 19px;\r\n  margin: 0 0 10px;\r\n}\r\n\r\n.regkings .rk-category p {\r\n  color: #6a7c86;\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n/* RESPONSIBLE MEDICINE USE */\r\n.regkings .rk-safety-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 45px;\r\n  align-items: center;\r\n}\r\n\r\n.regkings .rk-safety-panel {\r\n  background: #0c2a3b;\r\n  border: 1px solid rgba(32,200,120,.2);\r\n  border-radius: 14px;\r\n  padding: 30px;\r\n}\r\n\r\n.regkings .rk-safety-panel h3 {\r\n  color: #fff;\r\n  font-size: 23px;\r\n  margin: 0 0 20px;\r\n}\r\n\r\n.regkings .rk-safety-item {\r\n  display: flex;\r\n  gap: 13px;\r\n  margin: 17px 0;\r\n  color: var(--rk-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.regkings .rk-check {\r\n  color: var(--rk-green);\r\n  font-weight: 800;\r\n  font-size: 18px;\r\n}\r\n\r\n.regkings .rk-safety-copy h2 {\r\n  color: #fff;\r\n  font-size: clamp(28px, 4vw, 39px);\r\n  line-height: 1.2;\r\n  margin: 12px 0 18px;\r\n}\r\n\r\n.regkings .rk-safety-copy p {\r\n  color: var(--rk-muted);\r\n}\r\n\r\n.regkings .rk-safety-copy .rk-btn {\r\n  margin-top: 12px;\r\n}\r\n\r\n/* CONTACT BANNER */\r\n.regkings .rk-contact {\r\n  padding: 65px 0;\r\n  background: linear-gradient(110deg, #0d4938, #08764b);\r\n}\r\n\r\n.regkings .rk-contact-inner {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 30px;\r\n}\r\n\r\n.regkings .rk-contact h2 {\r\n  color: #fff;\r\n  font-size: clamp(25px, 4vw, 36px);\r\n  margin: 0 0 10px;\r\n}\r\n\r\n.regkings .rk-contact p {\r\n  color: #d6eee3;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-contact .rk-btn {\r\n  background: #fff;\r\n  color: #0b4835;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* FOOTER */\r\n.regkings .rk-footer {\r\n  background: #04121d;\r\n  padding: 35px 0 20px;\r\n  border-top: 1px solid rgba(255,255,255,.07);\r\n}\r\n\r\n.regkings .rk-footer-inner {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 25px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.regkings .rk-footer p {\r\n  color: #91a6b2;\r\n  font-size: 13px;\r\n  margin: 8px 0;\r\n}\r\n\r\n.regkings .rk-footer-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 16px;\r\n}\r\n\r\n.regkings .rk-footer-links a {\r\n  color: #c9d7de;\r\n  font-size: 13px;\r\n}\r\n\r\n.regkings .rk-footer-links a:hover {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-copyright {\r\n  border-top: 1px solid rgba(255,255,255,.08);\r\n  margin-top: 24px;\r\n  padding-top: 18px;\r\n  color: #8297a3;\r\n  font-size: 12px;\r\n}\r\n\r\n/* MOBILE RESPONSIVENESS */\r\n@media (max-width: 1000px) {\r\n  .regkings .rk-hero-grid {\r\n    gap: 30px;\r\n  }\r\n\r\n  .regkings .rk-categories {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  .regkings .rk-hero {\r\n    padding: 65px 0;\r\n  }\r\n\r\n  .regkings .rk-hero-grid,\r\n  .regkings .rk-safety-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .regkings .rk-hero-card {\r\n    padding: 25px;\r\n  }\r\n\r\n  .regkings .rk-section {\r\n    padding: 58px 0;\r\n  }\r\n\r\n  .regkings .rk-categories {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .regkings .rk-contact-inner {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .regkings .rk-contact .rk-btn {\r\n    white-space: normal;\r\n  }\r\n}\r\n</style>\r\n\r\n<div class=\"regkings\">\r\n\r\n  <!-- HERO -->\r\n  <section data-bs-version=\"5.1\" class=\"rk-hero\">\r\n    <div class=\"rk-container rk-hero-grid\">\r\n      <div>\r\n        <span class=\"rk-eyebrow\">RegKings Pharmacy</span>\r\n        <h1>Health and Wellness, <span>With Care.</span></h1>\r\n        <p>\r\n          Explore our pharmacy information and ask our team about product\r\n          availability, appropriate use, and the right next step for your\r\n          healthcare needs.\r\n        </p>\r\n\r\n        <div class=\"rk-hero-actions\">\r\n          <a href=\"contact.html\" class=\"rk-btn\">Contact Our Team</a>\r\n          <a href=\"#rk-categories\" class=\"rk-btn-outline\">Explore Categories</a>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-hero-card\">\r\n        <div class=\"rk-hero-icon\">✚</div>\r\n        <h3>Your Health Matters</h3>\r\n        <p>\r\n          Making informed choices is important. Ask a qualified healthcare\r\n          professional for advice when you have questions about medicines,\r\n          symptoms, or treatment.\r\n        </p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- PHARMACY CATEGORIES -->\r\n  <section class=\"rk-section rk-section-light\" id=\"rk-categories\">\r\n    <div class=\"rk-container\">\r\n      <div class=\"rk-heading\">\r\n        <span class=\"rk-eyebrow\">Pharmacy Categories</span>\r\n        <h2>Explore Our Pharmacy Range</h2>\r\n        <p>\r\n          These are general product categories to enquire about.\r\n          Availability may vary, so please contact us or visit the store\r\n          to confirm what is currently in stock.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"rk-categories\">\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-icon\">💊</div>\r\n          <h3>Medicines</h3>\r\n          <p>\r\n            Enquire about available medicines and obtain appropriate guidance\r\n            on their safe and responsible use.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-icon\">🩹</div>\r\n          <h3>First-Aid Essentials</h3>\r\n          <p>\r\n            Ask about basic first-aid supplies and other healthcare essentials\r\n            that may be available in store.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-icon\">🧴</div>\r\n          <h3>Personal Care</h3>\r\n          <p>\r\n            Explore personal hygiene and everyday care products suited to\r\n            your needs.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-icon\">🌿</div>\r\n          <h3>Health &amp; Wellness</h3>\r\n          <p>\r\n            Enquire about available wellness products and seek professional\r\n            advice before using supplements or new treatments.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-icon\">🧼</div>\r\n          <h3>Hygiene Products</h3>\r\n          <p>\r\n            Ask about hygiene and everyday household care products available\r\n            through the store.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-icon\">🤝</div>\r\n          <h3>Product Enquiries</h3>\r\n          <p>\r\n            Need a particular item? Contact us to ask about availability\r\n            before making a visit.\r\n          </p>\r\n        </article>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- RESPONSIBLE MEDICINE USE -->\r\n  <section class=\"rk-section\">\r\n    <div class=\"rk-container rk-safety-grid\">\r\n\r\n      <div class=\"rk-safety-panel\">\r\n        <h3>Important Medicine Safety Tips</h3>\r\n\r\n        <div class=\"rk-safety-item\">\r\n          <span class=\"rk-check\">✓</span>\r\n          <span>Use medicines according to the directions of a qualified healthcare professional.</span>\r\n        </div>\r\n\r\n        <div class=\"rk-safety-item\">\r\n          <span class=\"rk-check\">✓</span>\r\n          <span>Check the label, expiry date, and storage instructions before use.</span>\r\n        </div>\r\n\r\n        <div class=\"rk-safety-item\">\r\n          <span class=\"rk-check\">✓</span>\r\n          <span>Do not share prescription medicines with other people.</span>\r\n        </div>\r\n\r\n        <div class=\"rk-safety-item\">\r\n          <span class=\"rk-check\">✓</span>\r\n          <span>Keep medicines out of the reach of children.</span>\r\n        </div>\r\n\r\n        <div class=\"rk-safety-item\">\r\n          <span class=\"rk-check\">✓</span>\r\n          <span>Seek professional advice if you experience unexpected side effects or are unsure how to use a medicine.</span>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-safety-copy\">\r\n        <span class=\"rk-eyebrow\">Care Comes First</span>\r\n        <h2>Make Informed Healthcare Decisions.</h2>\r\n        <p>\r\n          Every person's healthcare needs are different. Avoid self-diagnosis\r\n          and do not take prescription medicines without appropriate medical\r\n          advice. A qualified healthcare professional can help you understand\r\n          your options and determine when further medical attention is needed.\r\n        </p>\r\n        <a href=\"contact.html\" class=\"rk-btn\">Make an Enquiry</a>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CONTACT CTA -->\r\n  <section class=\"rk-contact\">\r\n    <div class=\"rk-container rk-contact-inner\">\r\n      <div>\r\n        <h2>Looking for a Specific Product?</h2>\r\n        <p>Contact RegKings to enquire about availability before visiting.</p>\r\n      </div>\r\n      <a href=\"contact.html\" class=\"rk-btn\">Get in Touch →</a>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FOOTER -->\r\n  <footer class=\"rk-footer\">\r\n    <div class=\"rk-container\">\r\n      <div class=\"rk-footer-inner\">\r\n        <div>\r\n          <a href=\"index.html\" class=\"rk-brand\">\r\n            RegKings\r\n            <span>PATENT &amp; COSMETIC STORES</span>\r\n          </a>\r\n          <p>Everyday care. Informed choices. Responsible service.</p>\r\n        </div>\r\n\r\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\r\n          <a href=\"index.html\">Home</a>\r\n          <a href=\"about.html\">About</a>\r\n          <a href=\"pharmacy.html\">Pharmacy</a>\r\n          <a href=\"patents.html\">Patent Medicines</a>\r\n          <a href=\"cosmetics.html\">Cosmetics</a>\r\n          <a href=\"products.html\">Products</a>\r\n          <a href=\"contact.html\">Contact</a>\r\n          <a href=\"visit.html\">Visit Us</a>\r\n        </nav>\r\n      </div>\r\n\r\n      <div class=\"rk-copyright\">\r\n        © <span id=\"rk-year\">2026</span> RegKings Patent &amp; Cosmetic Stores.\r\n        All rights reserved.\r\n      </div>\r\n    </div>\r\n  </footer>\r\n\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  var year = document.getElementById(\"rk-year\");\r\n\r\n  if (year) {\r\n    year.textContent = new Date().getFullYear();\r\n  }\r\n})();\r\n</script>\r\n",
          "_cid": "GG6BbHZWFp",
