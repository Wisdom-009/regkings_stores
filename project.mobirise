        {
          "alias": false,
          "_styles": {
            "P": {
              "color": "#9fe870"
            }
          },
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\r\n/* REGKINGS PATENT MEDICINES PAGE */\r\n.regkings {\r\n  --rk-navy: #071b2b;\r\n  --rk-green: #20c878;\r\n  --rk-white: #ffffff;\r\n  --rk-muted: #b8c7d0;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n  color: var(--rk-white);\r\n  background: var(--rk-navy);\r\n  line-height: 1.7;\r\n  overflow: hidden;\r\n}\r\n\r\n.regkings * {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.regkings a {\r\n  text-decoration: none;\r\n}\r\n\r\n.regkings .rk-container {\r\n  width: 92%;\r\n  max-width: 1180px;\r\n  margin: auto;\r\n}\r\n\r\n/* FOOTER BRAND */\r\n.regkings .rk-brand {\r\n  color: #fff;\r\n  font-size: 21px;\r\n  font-weight: 800;\r\n  line-height: 1.25;\r\n}\r\n\r\n.regkings .rk-brand span {\r\n  display: block;\r\n  color: var(--rk-green);\r\n  font-size: 11px;\r\n  letter-spacing: 1.8px;\r\n  margin-top: 5px;\r\n}\r\n\r\n/* PAGE INTRODUCTION */\r\n.regkings .rk-page-intro {\r\n  padding: 66px 0 60px;\r\n  background: #0a2334;\r\n  border-bottom: 3px solid var(--rk-green);\r\n}\r\n\r\n.regkings .rk-breadcrumb {\r\n  font-size: 12px;\r\n  color: #a9bac5;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.regkings .rk-breadcrumb a {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-intro-grid {\r\n  display: grid;\r\n  grid-template-columns: 1.4fr .6fr;\r\n  align-items: center;\r\n  gap: 50px;\r\n}\r\n\r\n.regkings .rk-eyebrow {\r\n  color: var(--rk-green);\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  font-weight: 700;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n.regkings .rk-page-intro h1 {\r\n  color: #fff;\r\n  font-size: clamp(34px, 4.5vw, 53px);\r\n  line-height: 1.15;\r\n  margin: 13px 0 18px;\r\n}\r\n\r\n.regkings .rk-page-intro p {\r\n  color: var(--rk-muted);\r\n  max-width: 650px;\r\n  margin: 0 0 23px;\r\n}\r\n\r\n.regkings .rk-intro-mark {\r\n  border-left: 3px solid var(--rk-green);\r\n  padding: 10px 0 10px 25px;\r\n}\r\n\r\n.regkings .rk-intro-mark strong {\r\n  display: block;\r\n  font-size: 22px;\r\n  color: #fff;\r\n  line-height: 1.35;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.regkings .rk-intro-mark span {\r\n  color: var(--rk-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n/* BUTTONS */\r\n.regkings .rk-btn {\r\n  display: inline-block;\r\n  background: var(--rk-green);\r\n  color: #062033;\r\n  padding: 12px 21px;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  transition: background .2s ease;\r\n}\r\n\r\n.regkings .rk-btn:hover {\r\n  background: #47df96;\r\n}\r\n\r\n.regkings .rk-outline-btn {\r\n  display: inline-block;\r\n  border: 1px solid #718592;\r\n  color: #fff;\r\n  padding: 11px 20px;\r\n  border-radius: 4px;\r\n  margin-left: 9px;\r\n  font-size: 14px;\r\n}\r\n\r\n.regkings .rk-outline-btn:hover {\r\n  border-color: var(--rk-green);\r\n  color: var(--rk-green);\r\n}\r\n\r\n/* PRODUCT CATEGORIES */\r\n.regkings .rk-section {\r\n  padding: 68px 0;\r\n}\r\n\r\n.regkings .rk-section-light {\r\n  background: #f5f7f6;\r\n  color: #172e3a;\r\n}\r\n\r\n.regkings .rk-section-heading {\r\n  max-width: 740px;\r\n  margin-bottom: 35px;\r\n}\r\n\r\n.regkings .rk-section-heading h2 {\r\n  color: inherit;\r\n  font-size: clamp(27px, 3.5vw, 36px);\r\n  line-height: 1.25;\r\n  margin: 9px 0 12px;\r\n}\r\n\r\n.regkings .rk-section-heading p {\r\n  color: #697982;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-product-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 0 28px;\r\n}\r\n\r\n.regkings .rk-product {\r\n  padding: 25px 0;\r\n  border-top: 1px solid #d9e2de;\r\n}\r\n\r\n.regkings .rk-product-number {\r\n  color: #14834e;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.regkings .rk-product h3 {\r\n  color: #102b3b;\r\n  font-size: 19px;\r\n  margin: 7px 0;\r\n}\r\n\r\n.regkings .rk-product p {\r\n  color: #667781;\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n/* RESPONSIBLE USE */\r\n.regkings .rk-guidance {\r\n  padding: 65px 0;\r\n  background: #0c293a;\r\n}\r\n\r\n.regkings .rk-guidance-grid {\r\n  display: grid;\r\n  grid-template-columns: .85fr 1.15fr;\r\n  gap: 55px;\r\n  align-items: start;\r\n}\r\n\r\n.regkings .rk-guidance h2 {\r\n  color: #fff;\r\n  font-size: clamp(27px, 3.5vw, 36px);\r\n  line-height: 1.25;\r\n  margin: 10px 0 16px;\r\n}\r\n\r\n.regkings .rk-guidance p {\r\n  color: var(--rk-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.regkings .rk-guidance-list {\r\n  border-top: 1px solid #365064;\r\n}\r\n\r\n.regkings .rk-guidance-item {\r\n  display: flex;\r\n  gap: 16px;\r\n  padding: 17px 0;\r\n  border-bottom: 1px solid #365064;\r\n}\r\n\r\n.regkings .rk-guidance-item strong {\r\n  color: var(--rk-green);\r\n  font-size: 14px;\r\n  min-width: 25px;\r\n}\r\n\r\n.regkings .rk-guidance-item p {\r\n  color: #d3dfe5;\r\n  margin: 0;\r\n}\r\n\r\n/* ENQUIRY BANNER */\r\n.regkings .rk-enquiry {\r\n  padding: 48px 0;\r\n  background: #eaf5ee;\r\n  color: #122d3a;\r\n}\r\n\r\n.regkings .rk-enquiry-inner {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 25px;\r\n}\r\n\r\n.regkings .rk-enquiry h2 {\r\n  font-size: clamp(23px, 3vw, 31px);\r\n  margin: 0 0 7px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.regkings .rk-enquiry p {\r\n  color: #60736b;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-enquiry .rk-btn {\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* FOOTER */\r\n.regkings .rk-footer {\r\n  padding: 32px 0 18px;\r\n  background: #04121d;\r\n}\r\n\r\n.regkings .rk-footer-top {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 25px;\r\n}\r\n\r\n.regkings .rk-footer p {\r\n  color: #96a9b4;\r\n  font-size: 13px;\r\n  margin: 9px 0;\r\n}\r\n\r\n.regkings .rk-footer-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 15px;\r\n}\r\n\r\n.regkings .rk-footer-links a {\r\n  color: #c8d5dc;\r\n  font-size: 13px;\r\n}\r\n\r\n.regkings .rk-footer-links a:hover {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-copyright {\r\n  margin-top: 23px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid rgba(255,255,255,.09);\r\n  color: #8297a3;\r\n  font-size: 12px;\r\n}\r\n\r\n/* RESPONSIVE LAYOUT */\r\n@media (max-width: 1000px) {\r\n  .regkings .rk-product-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  .regkings .rk-page-intro {\r\n    padding: 45px 0;\r\n  }\r\n\r\n  .regkings .rk-intro-grid,\r\n  .regkings .rk-guidance-grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 28px;\r\n  }\r\n\r\n  .regkings .rk-intro-mark {\r\n    margin-top: 5px;\r\n  }\r\n\r\n  .regkings .rk-section {\r\n    padding: 48px 0;\r\n  }\r\n\r\n  .regkings .rk-product-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .regkings .rk-enquiry-inner {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .regkings .rk-outline-btn {\r\n    margin: 12px 0 0;\r\n  }\r\n}\r\n</style>\r\n\r\n<div class=\"regkings\">\r\n\r\n  <!-- PAGE INTRODUCTION -->\r\n  <section data-bs-version=\"5.1\" class=\"rk-page-intro\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-breadcrumb\">\r\n        <a href=\"home.html\">Home</a> &nbsp;/&nbsp; Patent Medicines\r\n      </div>\r\n\r\n      <div class=\"rk-intro-grid\">\r\n        <div>\r\n          <span class=\"rk-eyebrow\">RegKings · Patent Medicines</span>\r\n\r\n          <h1>Everyday Healthcare, With Care and Responsibility.</h1>\r\n\r\n          <p>\r\n            Looking for a familiar healthcare product? Explore the categories\r\n            below and contact RegKings to enquire about availability. We\r\n            encourage informed choices and the responsible use of medicines.\r\n          </p>\r\n\r\n          <a href=\"contact.html\" class=\"rk-btn\">Enquire About a Product</a>\r\n          <a href=\"pharmacy.html\" class=\"rk-outline-btn\">View Categories</a>\r\n        </div>\r\n\r\n        <div class=\"rk-intro-mark\">\r\n          <strong>Choose carefully. Use medicines responsibly.</strong>\r\n          <span>\r\n            Read product labels and seek advice from an appropriately\r\n            qualified healthcare professional whenever necessary.\r\n          </span>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- PRODUCT RANGE -->\r\n  <section class=\"rk-section rk-section-light\" id=\"rk-range\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-section-heading\">\r\n        <span class=\"rk-eyebrow\">Product Categories</span>\r\n        <h2>Explore Our Patent Medicine Categories</h2>\r\n        <p>\r\n          The categories below are provided to help customers make enquiries.\r\n          Actual stock and the range of products available should be confirmed\r\n          directly with the store.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"rk-product-grid\">\r\n\r\n        <article class=\"rk-product\">\r\n          <span class=\"rk-product-number\">01 / HEALTH</span>\r\n          <h3>Everyday Healthcare</h3>\r\n          <p>\r\n            Enquire about commonly requested healthcare products and follow\r\n            the instructions supplied with each product.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-product\">\r\n          <span class=\"rk-product-number\">02 / RELIEF</span>\r\n          <h3>Pain and Fever Relief</h3>\r\n          <p>\r\n            Ask about suitable products and their precautions. Check age\r\n            restrictions, dosage directions, and warnings before use.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-product\">\r\n          <span class=\"rk-product-number\">03 / COLD CARE</span>\r\n          <h3>Cold and Cough Products</h3>\r\n          <p>\r\n            Enquire about available products and seek professional advice\r\n            when symptoms are severe, persistent, or concerning.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-product\">\r\n          <span class=\"rk-product-number\">04 / FIRST AID</span>\r\n          <h3>First-Aid Supplies</h3>\r\n          <p>\r\n            Ask about basic first-aid items and wound-care supplies that\r\n            may be available at the store.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-product\">\r\n          <span class=\"rk-product-number\">05 / DIGESTIVE CARE</span>\r\n          <h3>Digestive Health Products</h3>\r\n          <p>\r\n            Enquire about products for common digestive concerns and obtain\r\n            appropriate advice before selecting a treatment.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"rk-product\">\r\n          <span class=\"rk-product-number\">06 / PERSONAL CARE</span>\r\n          <h3>Personal Care Essentials</h3>\r\n          <p>\r\n            Explore everyday personal-care and hygiene essentials. Contact\r\n            the store to confirm the current range.\r\n          </p>\r\n        </article>\r\n\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- RESPONSIBLE USE -->\r\n  <section class=\"rk-guidance\">\r\n    <div class=\"rk-container rk-guidance-grid\">\r\n\r\n      <div>\r\n        <span class=\"rk-eyebrow\">Customer Information</span>\r\n        <h2>Medicine Safety Should Always Come First.</h2>\r\n        <p>\r\n          Medicines can have side effects and may interact with other\r\n          medicines or existing health conditions. If you are unsure whether\r\n          a product is appropriate for you, consult a qualified healthcare\r\n          professional.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"rk-guidance-list\">\r\n\r\n        <div class=\"rk-guidance-item\">\r\n          <strong>01</strong>\r\n          <p>\r\n            <b>Read the label.</b> Follow the stated directions, warnings,\r\n            storage instructions, and expiry information.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"rk-guidance-item\">\r\n          <strong>02</strong>\r\n          <p>\r\n            <b>Use the correct product.</b> Do not assume a medicine is\r\n            suitable simply because it helped someone else.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"rk-guidance-item\">\r\n          <strong>03</strong>\r\n          <p>\r\n            <b>Ask before combining medicines.</b> A healthcare professional\r\n            can help identify potential interactions and precautions.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"rk-guidance-item\">\r\n          <strong>04</strong>\r\n          <p>\r\n            <b>Know when to seek medical care.</b> Serious or worsening\r\n            symptoms require appropriate medical assessment.\r\n          </p>\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- PRODUCT ENQUIRY -->\r\n  <section class=\"rk-enquiry\">\r\n    <div class=\"rk-container rk-enquiry-inner\">\r\n\r\n      <div>\r\n        <h2>Looking for a Particular Product?</h2>\r\n        <p>\r\n          Contact RegKings to ask whether the product is available before\r\n          visiting the store.\r\n        </p>\r\n      </div>\r\n\r\n      <a href=\"contact.html\" class=\"rk-btn\">Contact RegKings →</a>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FOOTER -->\r\n  <footer class=\"rk-footer\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-footer-top\">\r\n        <div>\r\n          <a href=\"home.html\" class=\"rk-brand\">\r\n            RegKings\r\n            <span>PATENT &amp; COSMETIC STORES</span>\r\n          </a>\r\n          <p>Everyday care. Informed choices. Responsible service.</p>\r\n        </div>\r\n\r\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\r\n          <a href=\"index.html\">Home</a>\r\n          <a href=\"about.html\">About</a>\r\n          <a href=\"pharmacy.html\">Pharmacy</a>\r\n          <a href=\"patents.html\">Patent Medicines</a>\r\n          <a href=\"cosmetics.html\">Cosmetics</a>\r\n          <a href=\"contact.html\">Contact</a>\r\n          <a href=\"visit.html\">Visit Us</a>\r\n        </nav>\r\n      </div>\r\n\r\n      <div class=\"rk-copyright\">\r\n        © <span id=\"rk-year\">2026</span>\r\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\r\n      </div>\r\n\r\n    </div>\r\n  </footer>\r\n\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  var year = document.getElementById(\"rk-year\");\r\n\r\n  if (year) {\r\n    year.textContent = new Date().getFullYear();\r\n  }\r\n})();\r\n</script>",
          "_cid": "GG6BpssD3O",
          "_anchor": "header09-8",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "cosmetics.html": {
      "settings": {
        "title": "cosmetics",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "4"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "z-index": "1000",
            "width": "100%",
            "position": "relative",
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            "@media (max-width: 767px)": {
              ".navbar-toggler": {
                "transform": "scale(0.8)"
              }
            },
            ".navbar-brand": {
              "img": {
                "max-width": "100%",
                "max-height": "100%",
                "border-radius": "0px !important"
              },
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".navbar-nav": {
              "margin": "auto",
              "margin-left": "0",
              "& when (@contentAlign = \"2\")": {
                "margin-left": "auto"
              },
              "& when (@contentAlign = \"3\")": {
                "margin-left": "auto",
                "margin-right": "0"
              },
              ".nav-item": {
                "padding": "0 !important",
                "transition": "0.3s all !important",
                ".nav-link": {
                  "padding": "16px !important",
                  "margin": "0 !important",
                  "border-radius": "1rem !important",
                  "transition": "0.3s all !important",
                  "&:hover": {
                    "background-color": "rgba(27, 31, 10, 0.06)"
                  },
                  "& when not (@isRoundedButtons)": {
                    "border-radius": "4px !important"
                  }
                }
              },
              ".open": {
                ".nav-link": {
                  "&::after": {
                    "transform": "rotate(180deg)"
                  },
                  "@media (min-width: 992px)": {
                    "&::before": {
                      "content": "\"\"",
                      "width": "100%",
                      "height": "20px",
                      "top": "100%",
                      "background": "transparent",
                      "position": "absolute"
                    }
                  }
                }
              },
              ".dropdown-item": {
                "padding": "12px !important",
                "border-radius": "0.5rem !important",
                "margin": "0 8px !important",
                "transition": "0.3s all !important",
                "&:hover": {
                  "background-color": "rgba(27, 31, 10, 0.06)"
                },
                "& when not (@isRoundedButtons)": {
                  "border-radius": "4px !important"
                }
              },
              "& when not (@showLogo), (@showBrand)": {
                "@media (min-width: 992px)": {
                  "padding-left": "1.5rem"
                }
              },
              "& when not (@showBrand)": {
                "@media (min-width: 992px)": {
                  "padding-left": "1.5rem"
                }
              }
            },
            ".nav-link": {
              "width": "fit-content",
              "position": "relative"
            },
            ".navbar-logo": {
              "padding-left": "2rem",
              "margin": "0 !important",
              "@media (max-width: 767px)": {
                "padding-left": "1rem"
              }
            },
            ".navbar-caption": {
              "padding-left": "1rem",
              "padding-right": "0.5rem",
              "& when not (@showLogo)": {
                "@media (min-width: 767px)": {
                  "padding-left": "2rem"
                }
              }
            },
            ".nav-dropdown": {
              "@media (max-width: 767px)": {
                "padding-bottom": "0.5rem"
              }
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem",
              "transition": "0.3s all"
            },
            ".container": {
              "display": "flex",
              "height": "90px",
              "padding": "0.5rem 0.6rem",
              "flex-wrap": "nowrap",
              "left": "0",
              "right": "0",
              "-webkit-box-pack": "justify",
              "-ms-flex-pack": "justify",
              "justify-content": "flex-end",
              "-webkit-box-align": "center",
              "-webkit-align-items": "center",
              "-ms-flex-align": "center",
              "align-items": "center",
              "border-radius": "100vw",
              "@media (max-width: 992px)": {
                "padding-right": "2rem"
              },
              "@media (max-width: 767px)": {
                "width": "95%",
                "height": "56px !important",
                "padding-right": "1rem",
                "margin-top": "0rem"
              },
              "& when not (@isRoundedButtons)": {
                "border-radius": "4px !important"
              }
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "padding-right": "0.5rem"
            },
            ".dropdown-menu": {
              "flex-wrap": "wrap",
              "flex-direction": "column",
              "max-width": "100%",
              "padding": "12px 4px !important",
              "border-radius": "1.5rem",
              "transition": "0.3s all !important",
              "min-width": "auto",
              "background": "@menuBgColor",
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
              },
              "& when not (@isRoundedButtons)": {
                "border-radius": "4px !important"
              }
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
