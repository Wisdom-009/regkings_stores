          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\r\n/* ==========================================\r\n   REGKINGS PATENT & COSMETIC STORES\r\n   ========================================== */\r\n\r\n.regkings,\r\n.regkings * {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.regkings {\r\n  --green: #00c896;\r\n  --green-dark: #008f70;\r\n  --navy: #061727;\r\n  --navy2: #0b2639;\r\n  --muted: #65788a;\r\n  --pale: #f1f8fa;\r\n  width: 100%;\r\n  overflow: hidden;\r\n  color: #14283c;\r\n  background: #ffffff;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n}\r\n\r\n.regkings img {\r\n  display: block;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.regkings a {\r\n  text-decoration: none !important;\r\n}\r\n\r\n.regkings .rk-wrap {\r\n  width: 92%;\r\n  max-width: 1240px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.regkings .rk-eyebrow {\r\n  display: block;\r\n  margin-bottom: 12px;\r\n  color: var(--green-dark);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 2px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.regkings .rk-btn {\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 13px 22px;\r\n  border: 1px solid var(--green);\r\n  border-radius: 30px;\r\n  background: var(--green);\r\n  color: #05251d !important;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  line-height: 1.4;\r\n  cursor: pointer;\r\n  transition: all 0.25s ease;\r\n}\r\n\r\n.regkings .rk-btn:hover {\r\n  background: #00e0a8;\r\n  border-color: #00e0a8;\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 8px 22px rgba(0, 200, 150, 0.2);\r\n}\r\n\r\n.regkings .rk-btn-outline {\r\n  color: #ffffff !important;\r\n  background: transparent;\r\n  border-color: rgba(0, 200, 150, 0.65);\r\n}\r\n\r\n.regkings .rk-btn-outline:hover {\r\n  color: var(--navy) !important;\r\n}\r\n\r\n/* HEADER */\r\n\r\n.regkings .rk-header {\r\n  position: relative;\r\n  z-index: 99;\r\n  background: #041321;\r\n  border-bottom: 1px solid rgba(0, 200, 150, 0.25);\r\n}\r\n\r\n.regkings .rk-nav {\r\n  min-height: 82px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n}\r\n\r\n.regkings .rk-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  color: #ffffff !important;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.regkings .rk-brand-mark {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 46px;\r\n  height: 46px;\r\n  border: 2px solid var(--green);\r\n  border-radius: 14px 14px 14px 4px;\r\n  color: var(--green);\r\n  font-size: 28px;\r\n  font-weight: 800;\r\n}\r\n\r\n.regkings .rk-brand-name {\r\n  display: block;\r\n  color: #ffffff;\r\n  font-size: 25px;\r\n  font-weight: 800;\r\n  line-height: 1.1;\r\n}\r\n\r\n.regkings .rk-brand-name span {\r\n  color: var(--green);\r\n}\r\n\r\n.regkings .rk-brand-sub {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: #d0dce5;\r\n  font-size: 10px;\r\n}\r\n\r\n.regkings .rk-menu {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 5px;\r\n}\r\n\r\n.regkings .rk-menu a.rk-navlink {\r\n  display: inline-block;\r\n  padding: 12px 9px;\r\n  color: #edf4f8 !important;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  transition: color 0.2s ease;\r\n}\r\n\r\n.regkings .rk-menu a.rk-navlink:hover,\r\n.regkings .rk-menu a.rk-navlink:focus {\r\n  color: var(--green) !important;\r\n}\r\n\r\n.regkings .rk-menu .rk-btn {\r\n  margin-left: 6px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.regkings .rk-mobile-toggle {\r\n  display: none;\r\n  width: 43px;\r\n  height: 43px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--green);\r\n  background: transparent;\r\n  border: 1px solid rgba(0, 200, 150, 0.6);\r\n  border-radius: 8px;\r\n  font-size: 25px;\r\n  cursor: pointer;\r\n}\r\n\r\n/* HERO */\r\n\r\n.regkings .rk-hero {\r\n  color: #ffffff;\r\n  padding: 62px 0;\r\n  background:\r\n    radial-gradient(circle at 85% 30%, rgba(0, 200, 150, 0.12), transparent 34%),\r\n    linear-gradient(120deg, #061727, #0b2639);\r\n}\r\n\r\n.regkings .rk-hero-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 48px;\r\n  align-items: center;\r\n}\r\n\r\n.regkings .rk-hero .rk-eyebrow,\r\n.regkings .rk-products .rk-eyebrow,\r\n.regkings .rk-promise .rk-eyebrow {\r\n  color: #62f4d0;\r\n}\r\n\r\n.regkings .rk-hero h1 {\r\n  margin: 14px 0;\r\n  color: #ffffff;\r\n  font-size: clamp(36px, 4.5vw, 59px);\r\n  font-weight: 800;\r\n  line-height: 1.12;\r\n  letter-spacing: -1.5px;\r\n}\r\n\r\n.regkings .rk-hero h1 span {\r\n  color: var(--green);\r\n}\r\n\r\n.regkings .rk-hero-copy {\r\n  max-width: 520px;\r\n  color: #d0dce6;\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n}\r\n\r\n.regkings .rk-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  margin-top: 25px;\r\n}\r\n\r\n.regkings .rk-trust-note {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin-top: 26px;\r\n  color: #d1dfe8;\r\n  font-size: 12px;\r\n}\r\n\r\n.regkings .rk-trust-note span {\r\n  color: var(--green);\r\n  font-weight: bold;\r\n}\r\n\r\n.regkings .rk-hero-image {\r\n  position: relative;\r\n}\r\n\r\n.regkings .rk-hero-image > img {\r\n  height: 390px;\r\n  border: 1px solid rgba(0, 200, 150, 0.33);\r\n  border-radius: 18px;\r\n  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.regkings .rk-image-label {\r\n  position: absolute;\r\n  bottom: 16px;\r\n  left: 16px;\r\n  right: 16px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 16px;\r\n  color: #ffffff;\r\n  background: rgba(4, 19, 33, 0.92);\r\n  border: 1px solid rgba(0, 200, 150, 0.4);\r\n  border-radius: 12px;\r\n}\r\n\r\n.regkings .rk-image-label .rk-spark {\r\n  color: var(--green);\r\n  font-size: 28px;\r\n}\r\n\r\n.regkings .rk-image-label strong,\r\n.regkings .rk-image-label small {\r\n  display: block;\r\n}\r\n\r\n.regkings .rk-image-label small {\r\n  margin-top: 4px;\r\n  color: #c3d4df;\r\n}\r\n\r\n/* BENEFITS */\r\n\r\n.regkings .rk-benefits {\r\n  padding: 25px 0;\r\n  border-bottom: 1px solid #e5edf1;\r\n  background: #ffffff;\r\n}\r\n\r\n.regkings .rk-benefit-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 16px;\r\n}\r\n\r\n.regkings .rk-benefit {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 10px;\r\n  border-right: 1px solid #e5edf1;\r\n}\r\n\r\n.regkings .rk-benefit:last-child {\r\n  border-right: 0;\r\n}\r\n\r\n.regkings .rk-benefit-icon {\r\n  color: var(--green-dark);\r\n  font-size: 30px;\r\n}\r\n\r\n.regkings .rk-benefit strong,\r\n.regkings .rk-benefit small {\r\n  display: block;\r\n}\r\n\r\n.regkings .rk-benefit strong {\r\n  margin-bottom: 5px;\r\n  font-size: 13px;\r\n}\r\n\r\n.regkings .rk-benefit small {\r\n  color: var(--muted);\r\n  font-size: 11px;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* SERVICES */\r\n\r\n.regkings .rk-services {\r\n  padding: 78px 0;\r\n  background: var(--pale);\r\n}\r\n\r\n.regkings .rk-heading {\r\n  max-width: 650px;\r\n  margin-bottom: 32px;\r\n}\r\n\r\n.regkings .rk-heading h2,\r\n.regkings .rk-products h2,\r\n.regkings .rk-contact h2 {\r\n  margin: 10px 0;\r\n  color: var(--navy);\r\n  font-size: clamp(29px, 3.5vw, 42px);\r\n  line-height: 1.2;\r\n  font-weight: 800;\r\n  letter-spacing: -0.7px;\r\n}\r\n\r\n.regkings .rk-heading h2 span,\r\n.regkings .rk-contact h2 span {\r\n  color: var(--green-dark);\r\n}\r\n\r\n.regkings .rk-heading > p {\r\n  color: #586d81;\r\n  font-size: 15px;\r\n  line-height: 1.8;\r\n}\r\n\r\n.regkings .rk-service-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 22px;\r\n}\r\n\r\n.regkings .rk-service-card {\r\n  overflow: hidden;\r\n  background: #ffffff;\r\n  border: 1px solid #e2ebef;\r\n  border-radius: 14px;\r\n  box-shadow: 0 8px 30px rgba(6, 23, 39, 0.04);\r\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\r\n}\r\n\r\n.regkings .rk-service-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 15px 35px rgba(6, 23, 39, 0.1);\r\n}\r\n\r\n.regkings .rk-service-card > img {\r\n  height: 205px;\r\n}\r\n\r\n.regkings .rk-card-content {\r\n  padding: 23px;\r\n}\r\n\r\n.regkings .rk-card-icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  margin-bottom: 10px;\r\n  border-radius: 10px;\r\n  background: #e1fbf3;\r\n  color: var(--green-dark);\r\n  font-size: 24px;\r\n}\r\n\r\n.regkings .rk-card-content h3 {\r\n  margin: 4px 0 10px;\r\n  color: var(--navy);\r\n  font-size: 21px;\r\n  font-weight: 700;\r\n}\r\n\r\n.regkings .rk-card-content p {\r\n  min-height: 65px;\r\n  color: #607489;\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.regkings .rk-text-link,\r\n.regkings .rk-product-link {\r\n  color: var(--green-dark) !important;\r\n  font-size: 13px;\r\n  font-weight: 800;\r\n}\r\n\r\n/* PRODUCTS */\r\n\r\n.regkings .rk-products {\r\n  padding: 78px 0;\r\n  color: #ffffff;\r\n  background: var(--navy);\r\n}\r\n\r\n.regkings .rk-products-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 24px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.regkings .rk-products h2 {\r\n  color: #ffffff;\r\n}\r\n\r\n.regkings .rk-products h2 span {\r\n  color: var(--green);\r\n}\r\n\r\n.regkings .rk-products-head p {\r\n  color: #bdccd6;\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.regkings .rk-product-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 18px;\r\n}\r\n\r\n.regkings .rk-product-card {\r\n  overflow: hidden;\r\n  border: 1px solid #dfe8ec;\r\n  border-radius: 12px;\r\n  background: #ffffff;\r\n  transition: transform 0.25s ease;\r\n}\r\n\r\n.regkings .rk-product-card:hover {\r\n  transform: translateY(-5px);\r\n}\r\n\r\n.regkings .rk-product-card > img {\r\n  height: 185px;\r\n  background: #f1f6f8;\r\n}\r\n\r\n.regkings .rk-product-info {\r\n  padding: 17px;\r\n}\r\n\r\n.regkings .rk-product-category {\r\n  color: var(--green-dark);\r\n  font-size: 9px;\r\n  font-weight: 800;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.regkings .rk-product-info h3 {\r\n  margin: 8px 0;\r\n  color: var(--navy);\r\n  font-size: 17px;\r\n}\r\n\r\n.regkings .rk-product-info p {\r\n  min-height: 40px;\r\n  color: #63768a;\r\n  font-size: 12px;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* BRAND PROMISE */\r\n\r\n.regkings .rk-promise {\r\n  padding: 68px 0;\r\n  color: #ffffff;\r\n  background:\r\n    radial-gradient(circle at 90% 30%, rgba(0, 200, 150, 0.12), transparent 35%),\r\n    #0a2235;\r\n}\r\n\r\n.regkings .rk-promise-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 45px;\r\n  align-items: center;\r\n}\r\n\r\n.regkings .rk-promise h2 {\r\n  margin: 10px 0 0;\r\n  color: #ffffff;\r\n  font-size: clamp(32px, 4vw, 46px);\r\n  line-height: 1.2;\r\n  font-weight: 800;\r\n}\r\n\r\n.regkings .rk-promise h2 span {\r\n  color: var(--green);\r\n}\r\n\r\n.regkings .rk-promise-copy p {\r\n  color: #cedbe4;\r\n  font-size: 15px;\r\n  line-height: 1.9;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n/* CONTACT */\r\n\r\n.regkings .rk-contact {\r\n  padding: 78px 0;\r\n  background: #ffffff;\r\n}\r\n\r\n.regkings .rk-contact-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 0.85fr;\r\n  gap: 55px;\r\n  align-items: start;\r\n}\r\n\r\n.regkings .rk-contact-intro {\r\n  color: #586d81;\r\n  font-size: 15px;\r\n  line-height: 1.8;\r\n}\r\n\r\n.regkings .rk-contact-detail {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 15px;\r\n  margin-top: 24px;\r\n}\r\n\r\n.regkings .rk-contact-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  width: 43px;\r\n  height: 43px;\r\n  color: var(--green-dark);\r\n  background: #e1fbf3;\r\n  border-radius: 10px;\r\n  font-size: 22px;\r\n}\r\n\r\n.regkings .rk-contact-detail strong {\r\n  display: block;\r\n  margin: 3px 0 5px;\r\n  color: var(--navy);\r\n}\r\n\r\n.regkings .rk-contact-detail p {\r\n  margin: 0;\r\n  color: #63768a;\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.regkings .rk-contact-detail a {\r\n  color: var(--green-dark) !important;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.regkings .rk-contact-detail a:hover {\r\n  text-decoration: underline !important;\r\n}\r\n\r\n.regkings .rk-contact-card {\r\n  padding: 32px;\r\n  border: 1px solid #dce9e9;\r\n  border-radius: 16px;\r\n  background: #f3faf8;\r\n}\r\n\r\n.regkings .rk-contact-card h3 {\r\n  margin: 12px 0;\r\n  color: var(--navy);\r\n  font-size: 26px;\r\n  font-weight: 800;\r\n}\r\n\r\n.regkings .rk-contact-card p {\r\n  color: #5d7183;\r\n  font-size: 14px;\r\n  line-height: 1.8;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.regkings .rk-contact-card small {\r\n  display: block;\r\n  margin-top: 14px;\r\n  color: #63768a;\r\n  font-size: 11px;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* FOOTER */\r\n\r\n.regkings .rk-footer {\r\n  color: #ffffff;\r\n  background: #041321;\r\n  border-top: 1px solid rgba(0, 200, 150, 0.25);\r\n}\r\n\r\n.regkings .rk-footer-top {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n  padding: 30px 0;\r\n}\r\n\r\n.regkings .rk-footer-tagline {\r\n  color: #d0dce5;\r\n  font-size: 13px;\r\n}\r\n\r\n.regkings .rk-back-top {\r\n  color: var(--green) !important;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n\r\n.regkings .rk-footer-bottom {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n  padding: 18px 0 22px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.12);\r\n}\r\n\r\n.regkings .rk-footer-bottom p {\r\n  margin: 0;\r\n  color: #a9bbc8;\r\n  font-size: 11px;\r\n  line-height: 1.7;\r\n}\r\n\r\n/* RESPONSIVE */\r\n\r\n@media (max-width: 1100px) {\r\n  .regkings .rk-nav {\r\n    gap: 12px;\r\n  }\r\n\r\n  .regkings .rk-menu {\r\n    gap: 0;\r\n  }\r\n\r\n  .regkings .rk-menu a.rk-navlink {\r\n    padding: 10px 6px;\r\n    font-size: 12px;\r\n  }\r\n\r\n  .regkings .rk-menu .rk-btn {\r\n    padding: 11px 14px;\r\n    font-size: 12px;\r\n  }\r\n}\r\n\r\n/* MOBILE MENU FIX */\r\n\r\n@media (max-width: 900px) {\r\n  .regkings .rk-nav {\r\n    position: relative;\r\n    min-height: 76px;\r\n    gap: 12px;\r\n  }\r\n\r\n  .regkings .rk-brand-name {\r\n    font-size: 23px;\r\n  }\r\n\r\n  .regkings .rk-brand-sub {\r\n    font-size: 9px;\r\n  }\r\n\r\n  .regkings .rk-mobile-toggle {\r\n    display: flex !important;\r\n    position: relative;\r\n    z-index: 1002;\r\n    flex-shrink: 0;\r\n    appearance: none;\r\n    -webkit-appearance: none;\r\n    touch-action: manipulation;\r\n    pointer-events: auto;\r\n  }\r\n\r\n  .regkings .rk-menu {\r\n    display: none !important;\r\n    position: absolute;\r\n    top: calc(100% + 6px);\r\n    left: 0;\r\n    right: 0;\r\n    z-index: 1001;\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    justify-content: flex-start;\r\n    gap: 0;\r\n    padding: 10px;\r\n    background: #041321;\r\n    border: 1px solid rgba(0, 200, 150, 0.35);\r\n    border-radius: 12px;\r\n    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.28);\r\n    visibility: hidden;\r\n    opacity: 0;\r\n    pointer-events: none;\r\n  }\r\n\r\n  .regkings .rk-menu.rk-menu-open {\r\n    display: flex !important;\r\n    visibility: visible;\r\n    opacity: 1;\r\n    pointer-events: auto;\r\n  }\r\n\r\n  .regkings .rk-menu a.rk-navlink {\r\n    display: block;\r\n    width: 100%;\r\n    padding: 14px 12px;\r\n    color: #edf4f8 !important;\r\n    font-size: 14px;\r\n    border-bottom: 1px solid rgba(255, 255, 255, 0.08);\r\n  }\r\n\r\n  .regkings .rk-menu .rk-btn {\r\n    width: 100%;\r\n    margin: 10px 0 0;\r\n    text-align: center;\r\n  }\r\n\r\n  .regkings .rk-hero {\r\n    padding: 45px 0;\r\n  }\r\n\r\n  .regkings .rk-hero-grid,\r\n  .regkings .rk-promise-grid,\r\n  .regkings .rk-contact-grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 30px;\r\n  }\r\n\r\n  .regkings .rk-hero-image > img {\r\n    height: 330px;\r\n  }\r\n\r\n  .regkings .rk-benefit-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n\r\n  .regkings .rk-benefit:nth-child(2) {\r\n    border-right: 0;\r\n  }\r\n\r\n  .regkings .rk-service-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .regkings .rk-product-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .regkings .rk-products-head {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .regkings .rk-contact-card {\r\n    padding: 24px;\r\n  }\r\n\r\n  .regkings .rk-footer-top,\r\n  .regkings .rk-footer-bottom {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n}\r\n\r\n@media (max-width: 560px) {\r\n  .regkings .rk-wrap {\r\n    width: 90%;\r\n  }\r\n\r\n  .regkings .rk-brand-mark {\r\n    width: 40px;\r\n    height: 40px;\r\n    font-size: 24px;\r\n  }\r\n\r\n  .regkings .rk-brand-name {\r\n    font-size: 21px;\r\n  }\r\n\r\n  .regkings .rk-brand-sub {\r\n    font-size: 8px;\r\n  }\r\n\r\n  .regkings .rk-hero h1 {\r\n    font-size: 37px;\r\n  }\r\n\r\n  .regkings .rk-hero-image > img {\r\n    height: 260px;\r\n  }\r\n\r\n  .regkings .rk-benefit-grid,\r\n  .regkings .rk-service-grid,\r\n  .regkings .rk-product-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .regkings .rk-benefit {\r\n    border-right: 0;\r\n    border-bottom: 1px solid #e5edf1;\r\n  }\r\n\r\n  .regkings .rk-benefit:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .regkings .rk-service-card > img {\r\n    height: 220px;\r\n  }\r\n\r\n  .regkings .rk-product-card > img {\r\n    height: 220px;\r\n  }\r\n\r\n  .regkings .rk-actions {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n  }\r\n\r\n  .regkings .rk-actions .rk-btn {\r\n    width: 100%;\r\n  }\r\n}\r\n</style>\r\n\r\n<div class=\"regkings\" id=\"rk-home\">\r\n\r\n  <!-- HEADER -->\r\n  <header class=\"rk-header\">\r\n    <div class=\"rk-wrap rk-nav\">\r\n\r\n      <a class=\"rk-brand\" href=\"#rk-home\">\r\n        <span class=\"rk-brand-mark\">✚</span>\r\n        <span>\r\n          <span class=\"rk-brand-name\">Reg<span>Kings</span></span>\r\n          <span class=\"rk-brand-sub\">Patent &amp; Cosmetic Stores</span>\r\n        </span>\r\n      </a>\r\n\r\n      <button class=\"rk-mobile-toggle\" type=\"button\"\r\n        aria-label=\"Open navigation\" aria-expanded=\"false\">\r\n        ☰\r\n      </button>\r\n\r\n      <nav class=\"rk-menu\">\r\n        <a class=\"rk-navlink\" href=\"index.html\">Home</a>\r\n        <a class=\"rk-navlink\" href=\"about.html\">About</a>\r\n        <a class=\"rk-navlink\" href=\"pharmacy.html\">Pharmacy</a>\r\n        <a class=\"rk-navlink\" href=\"patents.html\">Patents</a>\r\n        <a class=\"rk-navlink\" href=\"cosmetics.html\">Cosmetics</a>\r\n        <a class=\"rk-navlink\" href=\"products.html\">Products</a>\r\n        <a class=\"rk-navlink\" href=\"contact.html\">Contact</a>\r\n        <a class=\"rk-btn\" href=\"visit.html\">Visit Our Store →</a>\r\n      </nav>\r\n\r\n    </div>\r\n  </header>\r\n\r\n  <!-- HERO -->\r\n  <section data-bs-version=\"5.1\" class=\"rk-hero\">\r\n    <div class=\"rk-wrap rk-hero-grid\">\r\n\r\n      <div>\r\n        <span class=\"rk-eyebrow\">YOUR HEALTH · OUR PRIORITY</span>\r\n\r\n        <h1>Effective Medicines,<br><span>Healthy Lives.</span></h1>\r\n\r\n        <p class=\"rk-hero-copy\">\r\n          Welcome to RegKings Patent &amp; Cosmetic Stores,\r\n          your destination for healthcare essentials, patent medicine\r\n          products, skincare and beauty items.\r\n        </p>\r\n\r\n        <div class=\"rk-actions\">\r\n          <a class=\"rk-btn\" href=\"#rk-products\">Explore Products →</a>\r\n          <a class=\"rk-btn rk-btn-outline\" href=\"#rk-about\">Learn More</a>\r\n        </div>\r\n\r\n        <div class=\"rk-trust-note\">\r\n          <span>✓</span> Quality-focused service\r\n          <span>✓</span> Health and beauty essentials\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-hero-image\">\r\n        <img src=\"@PROJECT_PATH@/assets/images/grok-1792153568000-1108x744.jpeg\"\r\n          alt=\"Healthcare professional\">\r\n        <div class=\"rk-image-label\">\r\n          <span class=\"rk-spark\">✦</span>\r\n          <div>\r\n            <strong>Health. Beauty. Wellness.</strong>\r\n            <small>Care you can count on.</small>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- BENEFITS -->\r\n  <section class=\"rk-benefits\">\r\n    <div class=\"rk-wrap rk-benefit-grid\">\r\n\r\n      <div class=\"rk-benefit\">\r\n        <span class=\"rk-benefit-icon\">✚</span>\r\n        <div>\r\n          <strong>Health Essentials</strong>\r\n          <small>Everyday healthcare needs</small>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-benefit\">\r\n        <span class=\"rk-benefit-icon\">✧</span>\r\n        <div>\r\n          <strong>Beauty &amp; Care</strong>\r\n          <small>Personal care products</small>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-benefit\">\r\n        <span class=\"rk-benefit-icon\">✓</span>\r\n        <div>\r\n          <strong>Customer Service</strong>\r\n          <small>Friendly, helpful support</small>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-benefit\">\r\n        <span class=\"rk-benefit-icon\">⌖</span>\r\n        <div>\r\n          <strong>Visit Our Store</strong>\r\n          <small>Find our location online</small>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- ABOUT -->\r\n  <section class=\"rk-services\" id=\"rk-about\">\r\n    <div class=\"rk-wrap\">\r\n\r\n      <div class=\"rk-heading\">\r\n        <span class=\"rk-eyebrow\">WELCOME TO REGKINGS</span>\r\n        <h2>Health, Beauty &amp; <span>Everyday Care.</span></h2>\r\n        <p>\r\n          We provide a convenient place to explore healthcare essentials,\r\n          patent medicine products and personal care items.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"rk-service-grid\">\r\n\r\n        <article class=\"rk-service-card\" id=\"rk-pharmacy\">\r\n          <img src=\"@PROJECT_PATH@/assets/images/grok-1792153105553-740x497.jpg\"\r\n            alt=\"Pharmacy products\">\r\n          <div class=\"rk-card-content\">\r\n            <span class=\"rk-card-icon\">✚</span>\r\n            <h3>Pharmacy</h3>\r\n            <p>\r\n              Explore available medicines, healthcare essentials\r\n              and pharmacy products.\r\n            </p>\r\n            <a class=\"rk-text-link\" href=\"pharmacy.html\">Explore Pharmacy →</a>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-service-card\" id=\"rk-patents\">\r\n          <img src=\"@PROJECT_PATH@/assets/images/drugs-740x457.jpg\"\r\n            alt=\"Health products\">\r\n          <div class=\"rk-card-content\">\r\n            <span class=\"rk-card-icon\">＋</span>\r\n            <h3>Patent Medicines</h3>\r\n            <p>\r\n              Ask our team about product availability and appropriate\r\n              healthcare guidance.\r\n            </p>\r\n            <a class=\"rk-text-link\" href=\"patents.html\">Explore Patents →</a>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-service-card\" id=\"rk-cosmetics\">\r\n          <img src=\"@PROJECT_PATH@/assets/images/grok-1792153105553-740x497.jpg\"\r\n            alt=\"Skincare and cosmetics\">\r\n          <div class=\"rk-card-content\">\r\n            <span class=\"rk-card-icon\">✧</span>\r\n            <h3>Cosmetics &amp; Skincare</h3>\r\n            <p>\r\n              Explore skincare, haircare, beauty and personal care essentials.\r\n            </p>\r\n            <a class=\"rk-text-link\" href=\"cosmetics.html\">Explore Beauty →</a>\r\n          </div>\r\n        </article>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- PRODUCTS -->\r\n  <section class=\"rk-products\" id=\"rk-products\">\r\n    <div class=\"rk-wrap\">\r\n\r\n      <div class=\"rk-products-head\">\r\n        <div>\r\n          <span class=\"rk-eyebrow\">OUR COLLECTION</span>\r\n          <h2>Featured <span>Products</span></h2>\r\n          <p>Ask us about available products and current stock.</p>\r\n        </div>\r\n        <a class=\"rk-btn rk-btn-outline\" href=\"products.html\">\r\n          View All Products →\r\n        </a>\r\n      </div>\r\n\r\n      <div class=\"rk-product-grid\">\r\n\r\n        <article class=\"rk-product-card\">\r\n          <img src=\"https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&amp;fit=crop&amp;w=600&amp;q=80\"\r\n            alt=\"Skincare products\">\r\n          <div class=\"rk-product-info\">\r\n            <span class=\"rk-product-category\">PERSONAL CARE</span>\r\n            <h3>Daily Skincare</h3>\r\n            <p>Ask about available skincare products.</p>\r\n            <a class=\"rk-product-link\" href=\"contact.html\">Enquire Now →</a>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-product-card\">\r\n          <img src=\"https://images.unsplash.com/photo-1607619056574-7b8d3ee536b2?auto=format&amp;fit=crop&amp;w=600&amp;q=80\"\r\n            alt=\"Healthcare products\">\r\n          <div class=\"rk-product-info\">\r\n            <span class=\"rk-product-category\">HEALTH ESSENTIALS</span>\r\n            <h3>Health Products</h3>\r\n            <p>Ask about product availability.</p>\r\n            <a class=\"rk-product-link\" href=\"contact.html\">Enquire Now →</a>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-product-card\">\r\n          <img src=\"https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&amp;fit=crop&amp;w=600&amp;q=80\"\r\n            alt=\"Beauty products\">\r\n          <div class=\"rk-product-info\">\r\n            <span class=\"rk-product-category\">BEAUTY</span>\r\n            <h3>Beauty Essentials</h3>\r\n            <p>Discover cosmetics and beauty items.</p>\r\n            <a class=\"rk-product-link\" href=\"contact.html\">Enquire Now →</a>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-product-card\">\r\n          <img src=\"https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&amp;fit=crop&amp;w=600&amp;q=80\"\r\n            alt=\"Body care products\">\r\n          <div class=\"rk-product-info\">\r\n            <span class=\"rk-product-category\">BODY CARE</span>\r\n            <h3>Body &amp; Haircare</h3>\r\n            <p>Ask about available personal care products.</p>\r\n            <a class=\"rk-product-link\" href=\"contact.html\">Enquire Now →</a>\r\n          </div>\r\n        </article>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- BRAND PROMISE -->\r\n  <section class=\"rk-promise\">\r\n    <div class=\"rk-wrap rk-promise-grid\">\r\n\r\n      <div>\r\n        <span class=\"rk-eyebrow\">THE REGKINGS PROMISE</span>\r\n        <h2>Your Health and<br><span>Wellbeing Matter.</span></h2>\r\n      </div>\r\n\r\n      <div class=\"rk-promise-copy\">\r\n        <p>\r\n          At RegKings Patent &amp; Cosmetic Stores, we aim to make\r\n          healthcare essentials and personal care shopping convenient,\r\n          welcoming and dependable.\r\n        </p>\r\n        <a class=\"rk-btn\" href=\"about.html\">Learn More About Us →</a>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CONTACT -->\r\n  <section class=\"rk-contact\" id=\"rk-contact\">\r\n    <div class=\"rk-wrap rk-contact-grid\">\r\n\r\n      <div>\r\n        <span class=\"rk-eyebrow\">WE'RE HERE TO HELP</span>\r\n        <h2>Visit or Contact <span>RegKings.</span></h2>\r\n\r\n        <p class=\"rk-contact-intro\">\r\n          Contact our team to ask about products, availability,\r\n          store hours or other enquiries.\r\n        </p>\r\n\r\n        <div class=\"rk-contact-detail\">\r\n          <span class=\"rk-contact-icon\">⌖</span>\r\n          <div>\r\n            <strong>Our Store</strong>\r\n            <p>\r\n              No. 1 Femi Daramola St., Off Odo-Olowu,\r\n              Ijeshatedo, Surulere, Lagos.\r\n            </p>\r\n            <p>\r\n              <a href=\"https://www.google.com/maps/search/?api=1&amp;query=No.+1+Femi+Daramola+Street+Ijeshatedo+Surulere+Lagos\"\r\n                target=\"_blank\" rel=\"noopener\">\r\n                Find us on Google Maps →\r\n              </a>\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"rk-contact-detail\">\r\n          <span class=\"rk-contact-icon\">☎</span>\r\n          <div>\r\n            <strong>Phone / WhatsApp</strong>\r\n            <p>\r\n              <a href=\"tel:+2348032914054\">08032914054</a>\r\n            </p>\r\n            <p>\r\n              <a href=\"https://wa.me/2348032914054\"\r\n                target=\"_blank\" rel=\"noopener\">\r\n                Chat with us on WhatsApp →\r\n              </a>\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"rk-contact-detail\">\r\n          <span class=\"rk-contact-icon\">✉</span>\r\n          <div>\r\n            <strong>Email</strong>\r\n            <p>\r\n              <a href=\"contact.html\">\r\n                reginaudehcaregiver@gmail.com\r\n              </a>\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"rk-contact-card\">\r\n        <span class=\"rk-eyebrow\">REGKINGS PATENT &amp; COSMETIC STORES</span>\r\n        <h3>How can we help you?</h3>\r\n        <p>\r\n          Contact us with your product enquiry, and our team can help\r\n          you check availability and store details.\r\n        </p>\r\n\r\n        <a class=\"rk-btn\"\r\n          href=\"mailto:reginaudehcaregiver@gmail.com?subject=RegKings%20Product%20Enquiry\">\r\n          Email Our Team →\r\n        </a>\r\n\r\n        <small>\r\n          This button opens your email app with the RegKings email address\r\n          and a product enquiry subject already filled in.\r\n        </small>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FOOTER -->\r\n  <footer class=\"rk-footer\">\r\n    <div class=\"rk-wrap rk-footer-top\">\r\n\r\n      <a class=\"rk-brand\" href=\"#rk-home\">\r\n        <span class=\"rk-brand-mark\">✚</span>\r\n        <span>\r\n          <span class=\"rk-brand-name\">Reg<span>Kings</span></span>\r\n          <span class=\"rk-brand-sub\">Patent &amp; Cosmetic Stores</span>\r\n        </span>\r\n      </a>\r\n\r\n      <p class=\"rk-footer-tagline\">\r\n        Health · Beauty · Everyday Essentials\r\n      </p>\r\n\r\n      <a class=\"rk-back-top\" href=\"#rk-home\">Back to top ↑</a>\r\n\r\n    </div>\r\n\r\n    <div class=\"rk-wrap rk-footer-bottom\">\r\n      <p>\r\n        © <span class=\"rk-year\">2026</span>\r\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\r\n      </p>\r\n      <p>\r\n        Product availability and prices should be confirmed with the store.\r\n      </p>\r\n    </div>\r\n  </footer>\r\n\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  function initialiseRegKingsHomeMenu() {\r\n    var root = document.getElementById(\"rk-home\");\r\n\r\n    if (!root || root.getAttribute(\"data-rk-menu-ready\") === \"true\") {\r\n      return;\r\n    }\r\n\r\n    root.setAttribute(\"data-rk-menu-ready\", \"true\");\r\n\r\n    var year = root.querySelector(\".rk-year\");\r\n    if (year) {\r\n      year.textContent = new Date().getFullYear();\r\n    }\r\n\r\n    var menu = root.querySelector(\".rk-menu\");\r\n    var toggle = root.querySelector(\".rk-mobile-toggle\");\r\n\r\n    if (!menu || !toggle) {\r\n      return;\r\n    }\r\n\r\n    menu.id = menu.id || \"rk-home-menu\";\r\n    toggle.setAttribute(\"aria-controls\", menu.id);\r\n\r\n    function setMenuOpen(open) {\r\n      menu.classList.toggle(\"rk-menu-open\", open);\r\n      toggle.setAttribute(\"aria-expanded\", open ? \"true\" : \"false\");\r\n      toggle.textContent = open ? \"×\" : \"☰\";\r\n      toggle.setAttribute(\r\n        \"aria-label\",\r\n        open ? \"Close navigation\" : \"Open navigation\"\r\n      );\r\n    }\r\n\r\n    toggle.addEventListener(\"click\", function (event) {\r\n      event.preventDefault();\r\n      event.stopPropagation();\r\n\r\n      setMenuOpen(!menu.classList.contains(\"rk-menu-open\"));\r\n    });\r\n\r\n    menu.querySelectorAll(\"a\").forEach(function (link) {\r\n      link.addEventListener(\"click\", function () {\r\n        setMenuOpen(false);\r\n      });\r\n    });\r\n\r\n    document.addEventListener(\"click\", function (event) {\r\n      if (!menu.contains(event.target) && !toggle.contains(event.target)) {\r\n        setMenuOpen(false);\r\n      }\r\n    });\r\n\r\n    window.addEventListener(\"resize\", function () {\r\n      if (window.innerWidth > 900) {\r\n        setMenuOpen(false);\r\n      }\r\n    });\r\n  }\r\n\r\n  if (document.readyState === \"loading\") {\r\n    document.addEventListener(\r\n      \"DOMContentLoaded\",\r\n      initialiseRegKingsHomeMenu\r\n    );\r\n  } else {\r\n    initialiseRegKingsHomeMenu();\r\n  }\r\n})();\r\n</script>",
