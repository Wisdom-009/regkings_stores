          "_name": "menu06",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu6\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\t<mbr-parameters>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n\t\t\t<option value=\"1\">Left</option>\n\t\t\t<option value=\"2\">Center</option>\n\t\t\t<option value=\"3\" selected>Right</option>\n\t\t</select>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\t\t<header>Styles</header>\n\t\t<input type=\"checkbox\" title=\"Background on scroll\" name=\"opacityScroll\" condition=\"!transparent\">\n\t\t<input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" condition=\"!opacityScroll\">\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n\t\t<input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n\t\t<input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#041321\">\n\t\t<input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#000000\">\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown\" mbr-class=\"\n\t\t\t\t\t[\n\t\t\t\t\t{'opacityScrollOff': !opacityScroll, 'opacityScroll': opacityScroll}, \n\t\t\t\t\t{'navbar-fixed-top':sticky,'navbar-expand-lg':!collapsed,'collapsed':collapsed}\n\t\t\t\t\t]\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/regkings-pharmacy-logo-460x158.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Mobirise</a></span>\n\t\t\t</div>\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"collapse navbar-collapse\" mbr-class=\"{'opacityScrollOff': !opacityScroll, 'opacityScroll': opacityScroll}\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a>\n\t\t\t\t\t</li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"pharmacy.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Pharmacy</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"patents.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Patent</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"cosmetics.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Cosmetics</a></li>\n\t\t\t\t\t\n\t\t\t\t\t<li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-white text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Contacts</a>\n\t\t\t\t\t</li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"showIcons\">\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 2\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 3\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-shopping-cart mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary-outline\" href=\"visit.html\" data-app-placeholder=\"Type Text\">Visit Us Now</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</section>",
          "_cid": "vzrADbYwt4",
          "_anchor": "menu06-f",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n.regkings {\n  --navy: #102b2b;\n  --green: #287653;\n  --light-green: #eaf3ed;\n  --ink: #243431;\n  --muted: #687570;\n  --line: #dce5df;\n  font-family: Arial, Helvetica, sans-serif;\n  color: var(--ink);\n  background: #ffffff;\n  line-height: 1.7;\n}\n.regkings * { box-sizing: border-box; }\n.regkings a { color: inherit; }\n.regkings .container {\n  width: min(1120px, 92%);\n  margin: auto;\n}\n.regkings .site-header {\n  background: var(--navy);\n  color: #ffffff;\n  padding: 17px 0;\n}\n.regkings .nav-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n.regkings .brand {\n  color: #ffffff;\n  text-decoration: none;\n  font-size: 19px;\n  font-weight: 700;\n  line-height: 1.3;\n}\n.regkings .brand small {\n  display: block;\n  color: #c5d9ce;\n  font-size: 11px;\n  font-weight: 400;\n  letter-spacing: 1px;\n  margin-top: 4px;\n}\n.regkings .nav-links {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 17px;\n}\n.regkings .nav-links a {\n  color: #eaf2ed;\n  text-decoration: none;\n  font-size: 13px;\n}\n.regkings .nav-links a:hover,\n.regkings .nav-links a[aria-current=\"page\"] {\n  color: #a9dfba;\n}\n.regkings .menu-toggle {\n  display: none;\n  border: 1px solid #6c8c7c;\n  border-radius: 5px;\n  padding: 8px 11px;\n  background: transparent;\n  color: #ffffff;\n  cursor: pointer;\n}\n.regkings .page-intro {\n  padding: 65px 0 57px;\n  background: #f1f6f2;\n  border-bottom: 1px solid var(--line);\n}\n.regkings .eyebrow {\n  color: var(--green);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n}\n.regkings h1 {\n  color: var(--navy);\n  font-size: clamp(32px, 5vw, 48px);\n  line-height: 1.15;\n  letter-spacing: -1px;\n  margin: 13px 0 17px;\n}\n.regkings h2 {\n  color: var(--navy);\n  font-size: clamp(23px, 3vw, 31px);\n  line-height: 1.3;\n  margin: 0 0 14px;\n}\n.regkings h3 {\n  color: var(--navy);\n  font-size: 17px;\n  margin: 0 0 8px;\n}\n.regkings p { margin: 0 0 15px; }\n.regkings .intro-copy {\n  max-width: 690px;\n  color: #53625b;\n  font-size: 16px;\n}\n.regkings .section {\n  padding: 62px 0;\n}\n.regkings .location-grid {\n  display: grid;\n  grid-template-columns: 0.9fr 1.3fr;\n  gap: 32px;\n  align-items: stretch;\n}\n.regkings .location-panel {\n  padding: 28px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: #ffffff;\n}\n.regkings .address {\n  color: var(--ink);\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.8;\n  margin: 12px 0 22px;\n}\n.regkings .detail {\n  padding: 15px 0;\n  border-top: 1px solid var(--line);\n}\n.regkings .detail p {\n  color: var(--muted);\n  font-size: 14px;\n  margin: 0;\n}\n.regkings .button {\n  display: inline-block;\n  padding: 12px 17px;\n  border-radius: 5px;\n  background: var(--green);\n  color: #ffffff;\n  font-size: 14px;\n  font-weight: 700;\n  text-decoration: none;\n  margin-top: 8px;\n}\n.regkings .button:hover { background: #1d6041; }\n.regkings .button.secondary {\n  background: #ffffff;\n  color: var(--green);\n  border: 1px solid var(--green);\n}\n.regkings .map-wrap {\n  min-height: 450px;\n  overflow: hidden;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: #edf2ee;\n}\n.regkings .map-wrap iframe {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 450px;\n  border: 0;\n}\n.regkings .map-note {\n  font-size: 12px;\n  color: var(--muted);\n  margin-top: 10px;\n}\n.regkings .visit-info {\n  background: #f5f8f5;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n}\n.regkings .info-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n  margin-top: 28px;\n}\n.regkings .info-item {\n  background: #ffffff;\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: 7px;\n}\n.regkings .info-item p {\n  color: var(--muted);\n  font-size: 14px;\n  margin-bottom: 0;\n}\n.regkings .notice {\n  margin-top: 25px;\n  padding: 17px 20px;\n  border-left: 3px solid var(--green);\n  background: var(--light-green);\n  color: #3e5347;\n  font-size: 14px;\n}\n.regkings .cta {\n  padding: 45px 0;\n  background: var(--navy);\n  color: #ffffff;\n}\n.regkings .cta-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 24px;\n}\n.regkings .cta h2 { color: #ffffff; }\n.regkings .cta p {\n  color: #d2dfd7;\n  margin-bottom: 0;\n}\n.regkings .cta .button {\n  background: #ffffff;\n  color: var(--navy);\n  white-space: nowrap;\n}\n.regkings .footer {\n  background: #0b2020;\n  color: #d5e1da;\n  padding: 25px 0;\n  font-size: 12px;\n}\n.regkings .footer-row {\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.regkings .footer p { margin: 0; }\n@media (max-width: 850px) {\n  .regkings .nav-row { flex-wrap: wrap; }\n  .regkings .menu-toggle { display: block; }\n  .regkings .nav-links {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 0;\n    padding-top: 8px;\n  }\n  .regkings .nav-links.open { display: flex; }\n  .regkings .nav-links a {\n    display: block;\n    width: 100%;\n    padding: 10px 0;\n    border-top: 1px solid #294646;\n  }\n  .regkings .location-grid { grid-template-columns: 1fr; }\n  .regkings .map-wrap,\n  .regkings .map-wrap iframe { min-height: 360px; }\n  .regkings .info-grid { grid-template-columns: 1fr; }\n  .regkings .cta-row {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n}\n</style>\n\n<div class=\"regkings\">\n  <header class=\"site-header\">\n    <div class=\"container nav-row\">\n      <a class=\"brand\" href=\"home.html\">\n        RegKings\n        <small>PATENT &amp; COSMETIC STORES</small>\n      </a>\n\n      <button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"regkings-nav\">\n        Menu\n      </button>\n\n      <nav class=\"nav-links\" id=\"regkings-nav\" aria-label=\"Main navigation\">\n        <a href=\"index.html\">Home</a>\n        <a href=\"about.html\">About</a>\n        <a href=\"pharmacy.html\">Pharmacy</a>\n        <a href=\"patents.html\">Patent Medicines</a>\n        <a href=\"cosmetics.html\">Cosmetics</a>\n        <a href=\"contact.html\">Contact</a>\n        <a href=\"visit.html\" aria-current=\"page\">Visit Us</a>\n      </nav>\n    </div>\n  </header>\n\n  <section data-bs-version=\"5.1\" class=\"page-intro\">\n    <div class=\"container\">\n      <div class=\"eyebrow\">Find our store</div>\n      <h1>Visit RegKings</h1>\n      <p class=\"intro-copy\">\n        We welcome you to RegKings Patent &amp; Cosmetic Stores in\n        Ijeshatedo, Surulere, Lagos. Use the map and address below to\n        plan your visit and enquire about the products you need.\n      </p>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"container\">\n      <div class=\"location-grid\">\n        <div class=\"location-panel\">\n          <div class=\"eyebrow\">Our location</div>\n          <h2>For On-Site Assistance</h2>\n          <p>\n            Find us at the address below. If you are unfamiliar with\n            the area, open the map in Google Maps for directions.\n          </p>\n\n          <div class=\"address\">\n            No. 3 Femi Daramola Street,<br>\n            Off Odo-Olowu,<br>\n            Ijeshatedo, Surulere,<br>\n            Lagos State, Nigeria.\n          </div>\n\n          <a class=\"button\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.google.com/maps/dir/?api=1&destination=No+3+Femi+Daramola+Street%2C+Off+Odo-Olowu%2C+Ijeshatedo%2C+Surulere%2C+Lagos+State%2C+Nigeria\">\n            Get Directions\n          </a>\n\n          <div class=\"detail\">\n            <h3>What we offer</h3>\n            <p>\n              Enquiries about medicines and healthcare products,\n              alongside selected cosmetics and personal-care items.\n              Availability may vary.\n            </p>\n          </div>\n\n          <div class=\"detail\">\n            <h3>Opening hours</h3>\n            <p>\n              8:00 Am - 10:30 Pm.\n            </p>\n          </div>\n\n          <div class=\"detail\">\n            <h3>Need a particular product?</h3>\n            <p>\n              Contact the store before visiting to ask about product\n              availability. Only products the store is authorized\n              to sell should be supplied.\n            </p>\n            <a class=\"button secondary\" href=\"contact.html\">\n              Contact the Store\n            </a>\n          </div>\n        </div>\n\n        <div>\n          <div class=\"map-wrap\">\n            <iframe title=\"Google Maps search for RegKings Patent and Cosmetic Stores address\" src=\"https://maps.google.com/maps?q=No%203%20Femi%20Daramola%20Street%2C%20Off%20Odo-Olowu%2C%20Ijeshatedo%2C%20Surulere%2C%20Lagos%20State%2C%20Nigeria&output=embed\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen>\n            </iframe>\n          </div>\n          <p class=\"map-note\">\n            The map displays a Google Maps search for the supplied\n            address. Please verify the exact building location in\n            Google Maps before travelling.\n          </p>\n          <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.google.com/maps/search/?api=1&query=No+3+Femi+Daramola+Street%2C+Off+Odo-Olowu%2C+Ijeshatedo%2C+Surulere%2C+Lagos+State%2C+Nigeria\">\n            Open this location in Google Maps\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section visit-info\">\n    <div class=\"container\">\n      <div class=\"eyebrow\">Before you visit</div>\n      <h2>A few helpful details</h2>\n      <p>\n        We want your visit to be straightforward. These simple steps\n        can help you prepare before coming to the store.\n      </p>\n\n      <div class=\"info-grid\">\n        <div class=\"info-item\">\n          <h3>Plan your route</h3>\n          <p>\n            Use the Google Maps directions link above. Check the\n            suggested route and confirm the final street location\n            before setting out.\n          </p>\n        </div>\n\n        <div class=\"info-item\">\n          <h3>Check availability</h3>\n          <p>\n            If you need a specific product, enquire in advance.\n            A product shown or discussed online is not a guarantee\n            that it is currently available.\n          </p>\n        </div>\n\n        <div class=\"info-item\">\n          <h3>Medicine enquiries</h3>\n          <p>\n            For prescription medicines, bring the relevant prescription\n            where required. Ask an appropriately qualified healthcare\n            professional for advice about medicines.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"notice\">\n        <strong>Please note:</strong> The exact Google Maps pin,\n        telephone number, email address, and confirmed opening hours\n        should be checked before being advertised as verified details.\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cta\">\n    <div class=\"container cta-row\">\n      <div>\n        <h2>Looking for a particular product?</h2>\n        <p>\n          Send us an enquiry before visiting so you can plan ahead.\n        </p>\n      </div>\n      <a class=\"button\" href=\"contact.html\">Get in Touch</a>\n    </div>\n  </section>\n\n  <footer class=\"footer\">\n    <div class=\"container footer-row\">\n      <p>\n        © <span id=\"regkings-year\"></span>\n        RegKings Patent &amp; Cosmetic Stores.\n      </p>\n      <p>Ijeshatedo, Surulere, Lagos State, Nigeria.</p>\n    </div>\n  </footer>\n</div>\n\n<script>\n(function () {\n  var root = document.querySelector(\".regkings\");\n  if (!root) return;\n\n  var menuButton = root.querySelector(\".menu-toggle\");\n  var nav = root.querySelector(\".nav-links\");\n  var year = root.querySelector(\"#regkings-year\");\n\n  if (year) year.textContent = new Date().getFullYear();\n\n  if (menuButton && nav) {\n    menuButton.addEventListener(\"click\", function () {\n      var isOpen = nav.classList.toggle(\"open\");\n      menuButton.setAttribute(\"aria-expanded\", String(isOpen));\n    });\n  }\n})();\n</script>",
          "_cid": "GG6BG4tito",
          "_anchor": "header09-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "about.html": {
      "settings": {
        "title": "about",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "z-index": "1000",
            "width": "100%",
            "position": "relative",
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            "@media (max-width: 767px)": {
              ".navbar-toggler": {
                "transform": "scale(0.8)"
              }
            },
            ".navbar-brand": {
              "img": {
                "max-width": "100%",
                "max-height": "100%",
                "border-radius": "0px !important"
              },
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".navbar-nav": {
              "margin": "auto",
              "margin-left": "0",
              "& when (@contentAlign = \"2\")": {
                "margin-left": "auto"
              },
              "& when (@contentAlign = \"3\")": {
                "margin-left": "auto",
                "margin-right": "0"
              },
              ".nav-item": {
                "padding": "0 !important",
                "transition": "0.3s all !important",
                ".nav-link": {
                  "padding": "16px !important",
                  "margin": "0 !important",
                  "border-radius": "1rem !important",
                  "transition": "0.3s all !important",
                  "&:hover": {
                    "background-color": "rgba(27, 31, 10, 0.06)"
                  },
                  "& when not (@isRoundedButtons)": {
                    "border-radius": "4px !important"
                  }
                }
              },
              ".open": {
                ".nav-link": {
                  "&::after": {
                    "transform": "rotate(180deg)"
                  },
                  "@media (min-width: 992px)": {
                    "&::before": {
                      "content": "\"\"",
                      "width": "100%",
                      "height": "20px",
                      "top": "100%",
                      "background": "transparent",
                      "position": "absolute"
                    }
                  }
                }
              },
              ".dropdown-item": {
                "padding": "12px !important",
                "border-radius": "0.5rem !important",
                "margin": "0 8px !important",
                "transition": "0.3s all !important",
                "&:hover": {
                  "background-color": "rgba(27, 31, 10, 0.06)"
                },
                "& when not (@isRoundedButtons)": {
                  "border-radius": "4px !important"
                }
              },
              "& when not (@showLogo), (@showBrand)": {
                "@media (min-width: 992px)": {
