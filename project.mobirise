          "_name": "menu06",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu6\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\t<mbr-parameters>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n\t\t\t<option value=\"1\">Left</option>\n\t\t\t<option value=\"2\">Center</option>\n\t\t\t<option value=\"3\" selected>Right</option>\n\t\t</select>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\t\t<header>Styles</header>\n\t\t<input type=\"checkbox\" title=\"Background on scroll\" name=\"opacityScroll\" condition=\"!transparent\">\n\t\t<input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" condition=\"!opacityScroll\">\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n\t\t<input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n\t\t<input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#041321\">\n\t\t<input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#29eb19\">\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown\" mbr-class=\"\n\t\t\t\t\t[\n\t\t\t\t\t{'opacityScrollOff': !opacityScroll, 'opacityScroll': opacityScroll}, \n\t\t\t\t\t{'navbar-fixed-top':sticky,'navbar-expand-lg':!collapsed,'collapsed':collapsed}\n\t\t\t\t\t]\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/regkings-pharmacy-logo-460x158.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Mobirise</a></span>\n\t\t\t</div>\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"collapse navbar-collapse\" mbr-class=\"{'opacityScrollOff': !opacityScroll, 'opacityScroll': opacityScroll}\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a>\n\t\t\t\t\t</li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"pharmacy.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Pharmacy</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"patents.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Patent</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"cosmetics.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Cosmetics</a></li>\n\t\t\t\t\t\n\t\t\t\t\t<li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-white text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Contacts</a>\n\t\t\t\t\t</li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"showIcons\">\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 2\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 3\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-shopping-cart mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary-outline\" href=\"visit.html\" data-app-placeholder=\"Type Text\">Visit Us Now</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</section>",
          "_cid": "vzP2BelqBR",
          "_anchor": "menu06-i",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "\r\n<style>\r\n/* REGKINGS CONTACT PAGE */\r\n.regkings {\r\n  --rk-navy: #071b2b;\r\n  --rk-green: #20c878;\r\n  --rk-white: #ffffff;\r\n  --rk-muted: #b8c7d0;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n  color: var(--rk-white);\r\n  background: var(--rk-navy);\r\n  line-height: 1.7;\r\n  overflow: hidden;\r\n}\r\n\r\n.regkings * {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.regkings a {\r\n  text-decoration: none;\r\n}\r\n\r\n.regkings .rk-container {\r\n  width: 92%;\r\n  max-width: 1180px;\r\n  margin: auto;\r\n}\r\n\r\n/* PAGE INTRO */\r\n.regkings .rk-intro {\r\n  padding: 58px 0 55px;\r\n  background: #0a2334;\r\n  border-bottom: 3px solid var(--rk-green);\r\n}\r\n\r\n.regkings .rk-eyebrow {\r\n  color: var(--rk-green);\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  font-weight: 700;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n.regkings .rk-intro h1 {\r\n  font-size: clamp(35px, 4.5vw, 50px);\r\n  line-height: 1.15;\r\n  color: #fff;\r\n  margin: 12px 0 15px;\r\n}\r\n\r\n.regkings .rk-intro p {\r\n  color: var(--rk-muted);\r\n  max-width: 690px;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-breadcrumb {\r\n  color: #a9bac5;\r\n  font-size: 12px;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.regkings .rk-breadcrumb a {\r\n  color: var(--rk-green);\r\n}\r\n\r\n/* MAIN LAYOUT */\r\n.regkings .rk-contact-section {\r\n  padding: 65px 0;\r\n  background: #f5f7f6;\r\n  color: #172e3a;\r\n}\r\n\r\n.regkings .rk-contact-grid {\r\n  display: grid;\r\n  grid-template-columns: .8fr 1.2fr;\r\n  gap: 45px;\r\n  align-items: start;\r\n}\r\n\r\n/* CONTACT INFORMATION */\r\n.regkings .rk-contact-info h2 {\r\n  font-size: 29px;\r\n  line-height: 1.3;\r\n  margin: 9px 0 13px;\r\n  color: #102b3b;\r\n}\r\n\r\n.regkings .rk-contact-info > p {\r\n  color: #687982;\r\n  font-size: 14px;\r\n  margin-bottom: 27px;\r\n}\r\n\r\n.regkings .rk-info-item {\r\n  padding: 19px 0;\r\n  border-top: 1px solid #dce5e0;\r\n}\r\n\r\n.regkings .rk-info-item h3 {\r\n  color: #102b3b;\r\n  font-size: 16px;\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.regkings .rk-info-item p {\r\n  color: #687982;\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-info-item a {\r\n  color: #12834f;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.regkings .rk-info-item a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n/* DARK CONTACT FORM */\r\n.regkings .rk-form-card {\r\n  background: #071b2b;\r\n  border: 1px solid rgba(32, 200, 120, 0.35);\r\n  border-radius: 7px;\r\n  padding: 32px;\r\n  box-shadow: 0 12px 35px rgba(7, 27, 43, 0.12);\r\n}\r\n\r\n.regkings .rk-form-card h2 {\r\n  color: #ffffff;\r\n  font-size: 25px;\r\n  margin: 0 0 7px;\r\n}\r\n\r\n.regkings .rk-form-card > p {\r\n  color: #b8c7d0;\r\n  font-size: 14px;\r\n  margin: 0 0 24px;\r\n}\r\n\r\n.regkings .rk-row {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 17px;\r\n}\r\n\r\n.regkings .rk-field {\r\n  margin-bottom: 17px;\r\n}\r\n\r\n.regkings .rk-field label {\r\n  display: block;\r\n  color: #e5f0f4;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.regkings .rk-field input,\r\n.regkings .rk-field select,\r\n.regkings .rk-field textarea {\r\n  width: 100%;\r\n  border: 1px solid #294354;\r\n  background: #102b3b;\r\n  color: #ffffff;\r\n  padding: 12px 13px;\r\n  border-radius: 4px;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n  outline: none;\r\n  transition: border-color .2s ease, box-shadow .2s ease;\r\n}\r\n\r\n.regkings .rk-field input::placeholder,\r\n.regkings .rk-field textarea::placeholder {\r\n  color: #91a5b0;\r\n  opacity: 1;\r\n}\r\n\r\n.regkings .rk-field select {\r\n  color-scheme: dark;\r\n}\r\n\r\n.regkings .rk-field select option {\r\n  background: #102b3b;\r\n  color: #ffffff;\r\n}\r\n\r\n.regkings .rk-field input:focus,\r\n.regkings .rk-field select:focus,\r\n.regkings .rk-field textarea:focus {\r\n  border-color: #20c878;\r\n  box-shadow: 0 0 0 2px rgba(32, 200, 120, 0.15);\r\n}\r\n\r\n.regkings .rk-field textarea {\r\n  resize: vertical;\r\n  min-height: 125px;\r\n}\r\n\r\n.regkings .rk-submit {\r\n  width: 100%;\r\n  border: 0;\r\n  border-radius: 4px;\r\n  padding: 14px 20px;\r\n  background: var(--rk-green);\r\n  color: #062033;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  transition: background .2s ease, transform .2s ease;\r\n}\r\n\r\n.regkings .rk-submit:hover {\r\n  background: #47df96;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.regkings .rk-form-note {\r\n  color: #91a5b0;\r\n  font-size: 12px;\r\n  margin-top: 12px;\r\n}\r\n\r\n/* MEDICINE ENQUIRY BANNER */\r\n.regkings .rk-enquiry {\r\n  padding: 42px 0;\r\n  background: #0c293a;\r\n}\r\n\r\n.regkings .rk-enquiry-inner {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 25px;\r\n}\r\n\r\n.regkings .rk-enquiry h2 {\r\n  color: #fff;\r\n  font-size: clamp(22px, 3vw, 29px);\r\n  line-height: 1.3;\r\n  margin: 0 0 7px;\r\n}\r\n\r\n.regkings .rk-enquiry p {\r\n  color: var(--rk-muted);\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-btn {\r\n  display: inline-block;\r\n  background: var(--rk-green);\r\n  color: #062033;\r\n  padding: 12px 21px;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* FOOTER */\r\n.regkings .rk-footer {\r\n  padding: 32px 0 18px;\r\n  background: #04121d;\r\n}\r\n\r\n.regkings .rk-footer-top {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 25px;\r\n}\r\n\r\n.regkings .rk-footer p {\r\n  color: #96a9b4;\r\n  font-size: 13px;\r\n  margin: 9px 0;\r\n}\r\n\r\n.regkings .rk-footer-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 15px;\r\n}\r\n\r\n.regkings .rk-footer-links a {\r\n  color: #c8d5dc;\r\n  font-size: 13px;\r\n}\r\n\r\n.regkings .rk-footer-links a:hover {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-copyright {\r\n  margin-top: 23px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid rgba(255,255,255,.09);\r\n  color: #8297a3;\r\n  font-size: 12px;\r\n}\r\n\r\n/* RESPONSIVE */\r\n@media (max-width: 1000px) {\r\n  .regkings .rk-contact-grid {\r\n    gap: 28px;\r\n  }\r\n\r\n  .regkings .rk-form-card {\r\n    padding: 25px;\r\n  }\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  .regkings .rk-intro {\r\n    padding: 42px 0;\r\n  }\r\n\r\n  .regkings .rk-contact-section {\r\n    padding: 45px 0;\r\n  }\r\n\r\n  .regkings .rk-contact-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .regkings .rk-row {\r\n    grid-template-columns: 1fr;\r\n    gap: 0;\r\n  }\r\n\r\n  .regkings .rk-form-card {\r\n    padding: 22px;\r\n  }\r\n\r\n  .regkings .rk-enquiry-inner {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .regkings .rk-btn {\r\n    white-space: normal;\r\n  }\r\n}\r\n</style>\r\n\r\n<div class=\"regkings\">\r\n\r\n  <!-- INTRODUCTION -->\r\n  <section data-bs-version=\"5.1\" class=\"rk-intro\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-breadcrumb\">\r\n        <a href=\"home.html\">Home</a> &nbsp;/&nbsp; Contact\r\n      </div>\r\n\r\n      <span class=\"rk-eyebrow\">Contact RegKings</span>\r\n\r\n      <h1>We're Here to Help.</h1>\r\n\r\n      <p>\r\n        Have a question about a medicine, healthcare product, or cosmetic\r\n        item? Get in touch with us for product enquiries and general\r\n        information about our store.\r\n      </p>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CONTACT INFORMATION AND FORM -->\r\n  <section class=\"rk-contact-section\">\r\n    <div class=\"rk-container rk-contact-grid\">\r\n\r\n      <!-- CONTACT DETAILS -->\r\n      <div class=\"rk-contact-info\">\r\n        <span class=\"rk-eyebrow\">Get in Touch</span>\r\n\r\n        <h2>How Can We Assist You?</h2>\r\n\r\n        <p>\r\n          Contact us to enquire about product availability, general store\r\n          information, or other questions relating to RegKings Patent\r\n          &amp; Cosmetic Stores.\r\n        </p>\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Phone / WhatsApp</h3>\r\n          <p>+234 7087199524.</p>\r\n        </div>\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Email Address</h3>\r\n          <p>forwisdomswork@gmail.com</p>\r\n        </div>\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Store Address</h3>\r\n          <p>\r\n            3 Femi Daramola St. Off Odo-Olowu, Ijeshatedo, Surulere, Lagos State.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Product Enquiries</h3>\r\n          <p>\r\n            Please confirm availability with the store before travelling\r\n            to purchase a particular item.\r\n          </p>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- CONTACT FORM CONNECTED TO FORMSUBMIT -->\r\n      <div class=\"rk-form-card\">\r\n        <h2>Send an Enquiry</h2>\r\n\r\n        <p>\r\n          Fill in the form below with your details and message.\r\n        </p>\r\n\r\n        <form\r\n          id=\"rk-contact-form\"\r\n          action=\"https://formsubmit.co/forwisdomswork@gmail.com\"\r\n          method=\"POST\"\r\n        >\r\n\r\n          <!-- FORMSUBMIT SETTINGS -->\r\n          <input type=\"hidden\" name=\"_subject\"\r\n            value=\"New RegKings Website Enquiry\">\r\n\r\n          <input type=\"hidden\" name=\"_template\" value=\"table\">\r\n\r\n          <!-- REDIRECT TO THE CORRECT GITHUB PAGES CONTACT PAGE -->\r\n          <input type=\"hidden\" name=\"_next\"\r\n            value=\"https://wisdom-009.github.io/regkings_stores/contact.html\">\r\n\r\n          <!-- SPAM PROTECTION -->\r\n          <input type=\"text\" name=\"_honey\"\r\n            style=\"display:none\" tabindex=\"-1\" autocomplete=\"off\">\r\n\r\n          <div class=\"rk-row\">\r\n            <div class=\"rk-field\">\r\n              <label for=\"rk-name\">Full Name *</label>\r\n              <input type=\"text\" id=\"rk-name\" name=\"name\"\r\n                placeholder=\"Enter your name\"\r\n                autocomplete=\"name\" required>\r\n            </div>\r\n\r\n            <div class=\"rk-field\">\r\n              <label for=\"rk-phone\">Phone Number *</label>\r\n              <input type=\"tel\" id=\"rk-phone\" name=\"phone\"\r\n                placeholder=\"Enter your phone number\"\r\n                autocomplete=\"tel\" required>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"rk-field\">\r\n            <label for=\"rk-email\">Email Address</label>\r\n            <input type=\"email\" id=\"rk-email\" name=\"email\"\r\n              placeholder=\"Enter your email address\"\r\n              autocomplete=\"email\">\r\n          </div>\r\n\r\n          <div class=\"rk-field\">\r\n            <label for=\"rk-subject\">What Is Your Enquiry About? *</label>\r\n            <select id=\"rk-subject\" name=\"enquiry_type\" required>\r\n              <option value=\"\">Select an option</option>\r\n              <option value=\"Medicine enquiry\">Medicine enquiry</option>\r\n              <option value=\"Healthcare products\">Healthcare products</option>\r\n              <option value=\"Cosmetics and personal care\">Cosmetics and personal care</option>\r\n              <option value=\"Product availability\">Product availability</option>\r\n              <option value=\"Store information\">Store information</option>\r\n              <option value=\"Other enquiry\">Other enquiry</option>\r\n            </select>\r\n          </div>\r\n\r\n          <div class=\"rk-field\">\r\n            <label for=\"rk-message\">Your Message *</label>\r\n            <textarea id=\"rk-message\" name=\"message\"\r\n              placeholder=\"Write your enquiry here...\"\r\n              required></textarea>\r\n          </div>\r\n\r\n          <button type=\"submit\" class=\"rk-submit\">\r\n            Submit Enquiry\r\n          </button>\r\n\r\n          <p class=\"rk-form-note\">\r\n            Please do not include private medical records or other\r\n            sensitive personal information in this form.\r\n          </p>\r\n\r\n        </form>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- MEDICINE ENQUIRY -->\r\n  <section class=\"rk-enquiry\">\r\n    <div class=\"rk-container rk-enquiry-inner\">\r\n\r\n      <div>\r\n        <h2>Looking for a Medicine or Healthcare Product?</h2>\r\n        <p>\r\n          Visit our pharmacy page for more information about our main\r\n          business category.\r\n        </p>\r\n      </div>\r\n\r\n      <a href=\"pharmacy.html\" class=\"rk-btn\">Explore Pharmacy</a>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FOOTER -->\r\n  <footer class=\"rk-footer\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-footer-top\">\r\n        <div>\r\n          <a href=\"home.html\" class=\"rk-brand\">\r\n            RegKings\r\n            <span>PATENT &amp; COSMETIC STORES</span>\r\n          </a>\r\n\r\n          <p>\r\n            Medicines first, with additional products for everyday care.\r\n          </p>\r\n        </div>\r\n\r\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\r\n          <a href=\"index.html\">Home</a>\r\n          <a href=\"about.html\">About</a>\r\n          <a href=\"pharmacy.html\">Pharmacy</a>\r\n          <a href=\"patents.html\">Patent Medicines</a>\r\n          <a href=\"cosmetics.html\">Cosmetics</a>\r\n          <a href=\"contact.html\">Contact</a>\r\n          <a href=\"visit.html\">Visit Us</a>\r\n        </nav>\r\n      </div>\r\n\r\n      <div class=\"rk-copyright\">\r\n        © <span id=\"rk-year\">2026</span>\r\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\r\n      </div>\r\n\r\n    </div>\r\n  </footer>\r\n\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  var year = document.getElementById(\"rk-year\");\r\n\r\n  if (year) {\r\n    year.textContent = new Date().getFullYear();\r\n  }\r\n})();\r\n</script>\r\n",
