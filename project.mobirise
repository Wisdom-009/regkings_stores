        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\r\n/* REGKINGS COSMETICS PAGE */\r\n.regkings {\r\n  --rk-navy: #071b2b;\r\n  --rk-green: #20c878;\r\n  --rk-white: #ffffff;\r\n  --rk-muted: #b8c7d0;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n  color: var(--rk-white);\r\n  background: var(--rk-navy);\r\n  line-height: 1.7;\r\n  overflow: hidden;\r\n}\r\n\r\n.regkings * {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.regkings a {\r\n  text-decoration: none;\r\n}\r\n\r\n.regkings .rk-container {\r\n  width: 92%;\r\n  max-width: 1180px;\r\n  margin: auto;\r\n}\r\n\r\n.regkings .rk-brand {\r\n  color: #fff;\r\n  font-size: 21px;\r\n  font-weight: 800;\r\n  line-height: 1.25;\r\n}\r\n\r\n.regkings .rk-brand span {\r\n  display: block;\r\n  color: var(--rk-green);\r\n  font-size: 11px;\r\n  letter-spacing: 1.8px;\r\n  margin-top: 5px;\r\n}\r\n\r\n/* INTRODUCTION */\r\n.regkings .rk-intro {\r\n  padding: 65px 0;\r\n  background: #0a2334;\r\n  border-bottom: 3px solid var(--rk-green);\r\n}\r\n\r\n.regkings .rk-breadcrumb {\r\n  color: #a9bac5;\r\n  font-size: 12px;\r\n  margin-bottom: 23px;\r\n}\r\n\r\n.regkings .rk-breadcrumb a {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-intro-grid {\r\n  display: grid;\r\n  grid-template-columns: 1.25fr .75fr;\r\n  align-items: center;\r\n  gap: 55px;\r\n}\r\n\r\n.regkings .rk-eyebrow {\r\n  color: var(--rk-green);\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  font-weight: 700;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n.regkings .rk-intro h1 {\r\n  font-size: clamp(35px, 4.5vw, 52px);\r\n  line-height: 1.15;\r\n  color: #fff;\r\n  margin: 13px 0 18px;\r\n}\r\n\r\n.regkings .rk-intro p {\r\n  color: var(--rk-muted);\r\n  margin: 0 0 24px;\r\n  max-width: 620px;\r\n}\r\n\r\n.regkings .rk-intro-note {\r\n  border-left: 3px solid var(--rk-green);\r\n  padding: 12px 0 12px 23px;\r\n}\r\n\r\n.regkings .rk-intro-note h3 {\r\n  color: #fff;\r\n  font-size: 21px;\r\n  line-height: 1.4;\r\n  margin: 0 0 10px;\r\n}\r\n\r\n.regkings .rk-intro-note p {\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n/* BUTTONS */\r\n.regkings .rk-btn {\r\n  display: inline-block;\r\n  background: var(--rk-green);\r\n  color: #062033;\r\n  padding: 12px 21px;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  transition: background .2s ease;\r\n}\r\n\r\n.regkings .rk-btn:hover {\r\n  background: #47df96;\r\n}\r\n\r\n.regkings .rk-outline {\r\n  display: inline-block;\r\n  color: #fff;\r\n  border: 1px solid #718592;\r\n  padding: 11px 20px;\r\n  border-radius: 4px;\r\n  margin-left: 9px;\r\n  font-size: 14px;\r\n}\r\n\r\n.regkings .rk-outline:hover {\r\n  color: var(--rk-green);\r\n  border-color: var(--rk-green);\r\n}\r\n\r\n/* COSMETICS CATEGORIES */\r\n.regkings .rk-section {\r\n  padding: 68px 0;\r\n}\r\n\r\n.regkings .rk-section-light {\r\n  background: #f5f7f6;\r\n  color: #172e3a;\r\n}\r\n\r\n.regkings .rk-section-heading {\r\n  max-width: 730px;\r\n  margin-bottom: 35px;\r\n}\r\n\r\n.regkings .rk-section-heading h2 {\r\n  font-size: clamp(27px, 3.5vw, 36px);\r\n  line-height: 1.25;\r\n  margin: 9px 0 12px;\r\n}\r\n\r\n.regkings .rk-section-heading p {\r\n  color: #697982;\r\n  margin: 0;\r\n}\r\n\r\n.regkings .rk-category-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 24px;\r\n}\r\n\r\n.regkings .rk-category {\r\n  background: #fff;\r\n  border: 1px solid #e0e6e2;\r\n  border-radius: 5px;\r\n  overflow: hidden;\r\n  transition: border-color .2s ease;\r\n}\r\n\r\n.regkings .rk-category:hover {\r\n  border-color: #8bcfae;\r\n}\r\n\r\n.regkings .rk-category-top {\r\n  height: 5px;\r\n  background: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-category-content {\r\n  padding: 25px;\r\n}\r\n\r\n.regkings .rk-category-label {\r\n  color: #168451;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 1.5px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.regkings .rk-category h3 {\r\n  color: #102b3b;\r\n  font-size: 19px;\r\n  margin: 8px 0;\r\n}\r\n\r\n.regkings .rk-category p {\r\n  color: #687982;\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n/* SHOPPING INFORMATION */\r\n.regkings .rk-info {\r\n  padding: 65px 0;\r\n  background: #0c293a;\r\n}\r\n\r\n.regkings .rk-info-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 55px;\r\n  align-items: start;\r\n}\r\n\r\n.regkings .rk-info h2 {\r\n  color: #fff;\r\n  font-size: clamp(27px, 3.5vw, 36px);\r\n  line-height: 1.25;\r\n  margin: 10px 0 16px;\r\n}\r\n\r\n.regkings .rk-info p {\r\n  color: var(--rk-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.regkings .rk-info-list {\r\n  border-top: 1px solid #365064;\r\n}\r\n\r\n.regkings .rk-info-item {\r\n  padding: 17px 0;\r\n  border-bottom: 1px solid #365064;\r\n}\r\n\r\n.regkings .rk-info-item h3 {\r\n  color: #fff;\r\n  font-size: 16px;\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.regkings .rk-info-item p {\r\n  margin: 0;\r\n}\r\n\r\n/* MEDICINES FIRST */\r\n.regkings .rk-medicines {\r\n  padding: 43px 0;\r\n  background: #eaf5ee;\r\n  color: #173344;\r\n}\r\n\r\n.regkings .rk-medicines-inner {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 25px;\r\n}\r\n\r\n.regkings .rk-medicines h2 {\r\n  font-size: clamp(23px, 3vw, 30px);\r\n  line-height: 1.3;\r\n  margin: 0 0 8px;\r\n}\r\n\r\n.regkings .rk-medicines p {\r\n  color: #60736b;\r\n  margin: 0;\r\n}\r\n\r\n/* FOOTER */\r\n.regkings .rk-footer {\r\n  padding: 32px 0 18px;\r\n  background: #04121d;\r\n}\r\n\r\n.regkings .rk-footer-top {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 25px;\r\n}\r\n\r\n.regkings .rk-footer p {\r\n  color: #96a9b4;\r\n  font-size: 13px;\r\n  margin: 9px 0;\r\n}\r\n\r\n.regkings .rk-footer-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 15px;\r\n}\r\n\r\n.regkings .rk-footer-links a {\r\n  color: #c8d5dc;\r\n  font-size: 13px;\r\n}\r\n\r\n.regkings .rk-footer-links a:hover {\r\n  color: var(--rk-green);\r\n}\r\n\r\n.regkings .rk-copyright {\r\n  margin-top: 23px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid rgba(255,255,255,.09);\r\n  color: #8297a3;\r\n  font-size: 12px;\r\n}\r\n\r\n/* RESPONSIVE LAYOUT */\r\n@media (max-width: 1000px) {\r\n  .regkings .rk-category-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  .regkings .rk-intro {\r\n    padding: 45px 0;\r\n  }\r\n\r\n  .regkings .rk-intro-grid,\r\n  .regkings .rk-info-grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 28px;\r\n  }\r\n\r\n  .regkings .rk-section {\r\n    padding: 48px 0;\r\n  }\r\n\r\n  .regkings .rk-category-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .regkings .rk-medicines-inner {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .regkings .rk-outline {\r\n    margin: 12px 0 0;\r\n  }\r\n}\r\n</style>\r\n\r\n<div class=\"regkings\">\r\n\r\n  <!-- INTRODUCTION -->\r\n  <section data-bs-version=\"5.1\" class=\"rk-intro\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-breadcrumb\">\r\n        <a href=\"home.html\">Home</a> &nbsp;/&nbsp; Cosmetics\r\n      </div>\r\n\r\n      <div class=\"rk-intro-grid\">\r\n        <div>\r\n          <span class=\"rk-eyebrow\">More for Your Everyday Needs</span>\r\n\r\n          <h1>Personal Care Products for Everyday Living.</h1>\r\n\r\n          <p>\r\n            Alongside our main focus on medicines and healthcare products,\r\n            RegKings also offers a selection of cosmetic and personal-care\r\n            products. Explore the categories below and contact us to enquire\r\n            about available items.\r\n          </p>\r\n\r\n          <a href=\"contact.html\" class=\"rk-btn\">Enquire About Products</a>\r\n          <a href=\"pharmacy.html\" class=\"rk-outline\">Explore Categories</a>\r\n        </div>\r\n\r\n        <div class=\"rk-intro-note\">\r\n          <h3>Healthcare remains our main focus.</h3>\r\n          <p>\r\n            Cosmetics and personal-care items complement our wider product\r\n            range, giving customers another option for their everyday needs.\r\n          </p>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- COSMETICS CATEGORIES -->\r\n  <section class=\"rk-section rk-section-light\" id=\"rk-categories\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-section-heading\">\r\n        <span class=\"rk-eyebrow\">Cosmetics &amp; Personal Care</span>\r\n        <h2>Everyday Care Essentials</h2>\r\n        <p>\r\n          Browse these general categories to see the types of products you\r\n          may enquire about. Product selection and availability can vary.\r\n          Please contact the store to confirm current stock.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"rk-category-grid\">\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-top\"></div>\r\n          <div class=\"rk-category-content\">\r\n            <span class=\"rk-category-label\">01 / Skin</span>\r\n            <h3>Skin Care</h3>\r\n            <p>\r\n              Enquire about available skin moisturisers, cleansers, and\r\n              other everyday skin-care products.\r\n            </p>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-top\"></div>\r\n          <div class=\"rk-category-content\">\r\n            <span class=\"rk-category-label\">02 / Hair</span>\r\n            <h3>Hair Care</h3>\r\n            <p>\r\n              Ask about hair-care products and accessories that may be\r\n              available in store.\r\n            </p>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-top\"></div>\r\n          <div class=\"rk-category-content\">\r\n            <span class=\"rk-category-label\">03 / Body</span>\r\n            <h3>Body Care</h3>\r\n            <p>\r\n              Explore everyday body-care products, including items intended\r\n              for regular personal hygiene.\r\n            </p>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-top\"></div>\r\n          <div class=\"rk-category-content\">\r\n            <span class=\"rk-category-label\">04 / Beauty</span>\r\n            <h3>Beauty Essentials</h3>\r\n            <p>\r\n              Enquire about selected beauty and cosmetic essentials available\r\n              through the store.\r\n            </p>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-top\"></div>\r\n          <div class=\"rk-category-content\">\r\n            <span class=\"rk-category-label\">05 / Hygiene</span>\r\n            <h3>Personal Hygiene</h3>\r\n            <p>\r\n              Ask about everyday personal-hygiene products and other\r\n              personal-care essentials.\r\n            </p>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"rk-category\">\r\n          <div class=\"rk-category-top\"></div>\r\n          <div class=\"rk-category-content\">\r\n            <span class=\"rk-category-label\">06 / Enquiries</span>\r\n            <h3>Product Availability</h3>\r\n            <p>\r\n              Looking for a specific brand or item? Contact us to check\r\n              whether it is currently available.\r\n            </p>\r\n          </div>\r\n        </article>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CUSTOMER INFORMATION -->\r\n  <section class=\"rk-info\">\r\n    <div class=\"rk-container rk-info-grid\">\r\n\r\n      <div>\r\n        <span class=\"rk-eyebrow\">Choosing Products</span>\r\n        <h2>Make the Right Choice for Your Needs.</h2>\r\n        <p>\r\n          Personal-care products can differ in their ingredients, intended\r\n          use, and suitability for different people. Read labels carefully\r\n          and follow the manufacturer's directions.\r\n        </p>\r\n        <p>\r\n          If a product causes an unexpected reaction, stop using it and seek\r\n          appropriate medical advice when necessary.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"rk-info-list\">\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Check the Ingredients</h3>\r\n          <p>\r\n            Review the product label, particularly if you have known\r\n            sensitivities or allergies.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Check Product Information</h3>\r\n          <p>\r\n            Follow the manufacturer's instructions and observe any\r\n            recommended storage conditions.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"rk-info-item\">\r\n          <h3>Confirm Availability</h3>\r\n          <p>\r\n            Contact RegKings before visiting if you are looking for a\r\n            particular cosmetic or personal-care product.\r\n          </p>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- MEDICINES REMAIN THE MAIN BUSINESS -->\r\n  <section class=\"rk-medicines\">\r\n    <div class=\"rk-container rk-medicines-inner\">\r\n\r\n      <div>\r\n        <h2>Looking for Medicines Instead?</h2>\r\n        <p>\r\n          Medicines and healthcare products remain our primary focus.\r\n          Visit our pharmacy page to learn more.\r\n        </p>\r\n      </div>\r\n\r\n      <a href=\"pharmacy.html\" class=\"rk-btn\">Explore Pharmacy</a>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FOOTER -->\r\n  <footer class=\"rk-footer\">\r\n    <div class=\"rk-container\">\r\n\r\n      <div class=\"rk-footer-top\">\r\n        <div>\r\n          <a href=\"home.html\" class=\"rk-brand\">\r\n            RegKings\r\n            <span>PATENT &amp; COSMETIC STORES</span>\r\n          </a>\r\n          <p>\r\n            Medicines first, with additional products for everyday care.\r\n          </p>\r\n        </div>\r\n\r\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\r\n          <a href=\"index.html\">Home</a>\r\n          <a href=\"about.html\">About</a>\r\n          <a href=\"pharmacy.html\">Pharmacy</a>\r\n          <a href=\"patents.html\">Patent Medicines</a>\r\n          <a href=\"cosmetics.html\">Cosmetics</a>\r\n          <a href=\"products.html\">Products</a>\r\n          <a href=\"contact.html\">Contact</a>\r\n          <a href=\"visit.html\">Visit Us</a>\r\n        </nav>\r\n      </div>\r\n\r\n      <div class=\"rk-copyright\">\r\n        © <span id=\"rk-year\">2026</span>\r\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\r\n      </div>\r\n\r\n    </div>\r\n  </footer>\r\n\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  var year = document.getElementById(\"rk-year\");\r\n\r\n  if (year) {\r\n    year.textContent = new Date().getFullYear();\r\n  }\r\n})();\r\n</script>",
