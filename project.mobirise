          "_name": "menu06",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu6\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\t<mbr-parameters>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n\t\t\t<option value=\"1\">Left</option>\n\t\t\t<option value=\"2\">Center</option>\n\t\t\t<option value=\"3\" selected>Right</option>\n\t\t</select>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\t\t<header>Styles</header>\n\t\t<input type=\"checkbox\" title=\"Background on scroll\" name=\"opacityScroll\" condition=\"!transparent\">\n\t\t<input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" condition=\"!opacityScroll\">\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n\t\t<input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n\t\t<input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#041321\">\n\t\t<input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#000000\">\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown\" mbr-class=\"\n\t\t\t\t\t[\n\t\t\t\t\t{'opacityScrollOff': !opacityScroll, 'opacityScroll': opacityScroll}, \n\t\t\t\t\t{'navbar-fixed-top':sticky,'navbar-expand-lg':!collapsed,'collapsed':collapsed}\n\t\t\t\t\t]\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/regkings-pharmacy-logo-460x158.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Mobirise</a></span>\n\t\t\t</div>\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"collapse navbar-collapse\" mbr-class=\"{'opacityScrollOff': !opacityScroll, 'opacityScroll': opacityScroll}\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a>\n\t\t\t\t\t</li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"pharmacy.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Pharmacy</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"patents.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Patent</a></li><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"cosmetics.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Cosmetics</a></li>\n\t\t\t\t\t\n\t\t\t\t\t<li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-white text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Contacts</a>\n\t\t\t\t\t</li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"showIcons\">\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 2\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 3\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-shopping-cart mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary-outline\" href=\"visit.html\" data-app-placeholder=\"Type Text\">Visit Us Now</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</section>",
          "_cid": "vzrADbYwt4",
          "_anchor": "menu06-f",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "H2": {
              "color": "#757b62"
            },
            "P": {
              "color": "#a6a99c"
            }
          },
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<meta name=\"theme-color\" content=\"#0b1513\">\r\n<meta name=\"description\" content=\"Learn about RegKings Patent & Cosmetic Stores, our mission, healthcare essentials, skincare products and commitment to customer care.\">\r\n\r\n<title>About Us | RegKings Patent &amp; Cosmetic Stores</title>\r\n\r\n<style>\r\n/* =========================\r\n   REGKINGS WEBSITE STYLES\r\n========================= */\r\n\r\n:root {\r\n  --background: #0b1513;\r\n  --surface: #111f1b;\r\n  --surface-light: #192923;\r\n  --green: #10c982;\r\n  --green-light: #56e3a6;\r\n  --cream: #f5ead1;\r\n  --white: #ffffff;\r\n  --muted: #b4c2ba;\r\n  --border: rgba(255,255,255,0.09);\r\n}\r\n\r\n* {\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  scroll-behavior: smooth;\r\n  scroll-padding-top: 100px;\r\n}\r\n\r\nbody {\r\n  font-family: Arial, Helvetica, sans-serif;\r\n  background: var(--background);\r\n  color: var(--white);\r\n  line-height: 1.7;\r\n  overflow-x: hidden;\r\n}\r\n\r\na {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\nbutton {\r\n  font: inherit;\r\n}\r\n\r\nimg {\r\n  max-width: 100%;\r\n  display: block;\r\n}\r\n\r\n.container {\r\n  width: 90%;\r\n  max-width: 1180px;\r\n  margin: auto;\r\n}\r\n\r\n.section {\r\n  padding: 90px 0;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  color: var(--green-light);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 2px;\r\n  text-transform: uppercase;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.section-title {\r\n  font-size: clamp(30px, 4vw, 45px);\r\n  line-height: 1.2;\r\n  letter-spacing: -1.4px;\r\n  margin-bottom: 22px;\r\n  color: var(--cream);\r\n}\r\n\r\n.section-description {\r\n  color: var(--muted);\r\n  max-width: 650px;\r\n  font-size: 15px;\r\n}\r\n\r\n/* HERO */\r\n\r\n.about-hero {\r\n  padding: 95px 0 90px;\r\n  background:\r\n    radial-gradient(\r\n      ellipse at 85% 20%,\r\n      rgba(16,201,130,0.12),\r\n      transparent 40%\r\n    ),\r\n    var(--background);\r\n}\r\n\r\n.hero-grid {\r\n  display: grid;\r\n  grid-template-columns: 1.05fr 0.95fr;\r\n  align-items: center;\r\n  gap: 65px;\r\n}\r\n\r\n.hero-copy h1 {\r\n  color: var(--cream);\r\n  font-size: clamp(42px, 5vw, 65px);\r\n  line-height: 1.08;\r\n  letter-spacing: -2.5px;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.hero-copy h1 span {\r\n  color: var(--green);\r\n}\r\n\r\n.hero-copy p {\r\n  max-width: 560px;\r\n  color: var(--muted);\r\n  font-size: 16px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.hero-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 14px;\r\n}\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 14px 22px;\r\n  border-radius: 30px;\r\n  font-size: 13px;\r\n  font-weight: 800;\r\n  transition: 0.25s ease;\r\n}\r\n\r\n.btn-primary {\r\n  color: #06251a;\r\n  background: var(--green);\r\n}\r\n\r\n.btn-primary:hover {\r\n  background: var(--green-light);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.btn-outline {\r\n  border: 1px solid rgba(255,255,255,0.18);\r\n  color: var(--cream);\r\n}\r\n\r\n.btn-outline:hover {\r\n  border-color: var(--green);\r\n  color: var(--green-light);\r\n}\r\n\r\n.hero-visual {\r\n  min-height: 420px;\r\n  position: relative;\r\n  border: 1px solid rgba(16,201,130,0.22);\r\n  border-radius: 28px;\r\n  overflow: hidden;\r\n  background:\r\n    linear-gradient(\r\n      180deg,\r\n      rgba(11,21,19,0.02),\r\n      rgba(11,21,19,0.85)\r\n    ),\r\n    url(\"https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=1000&q=85\")\r\n    center / cover no-repeat,\r\n    #20372d;\r\n  box-shadow: 0 25px 70px rgba(0,0,0,0.25);\r\n}\r\n\r\n.hero-label {\r\n  position: absolute;\r\n  bottom: 20px;\r\n  left: 20px;\r\n  right: 20px;\r\n  padding: 20px;\r\n  border: 1px solid rgba(255,255,255,0.1);\r\n  background: rgba(11,21,19,0.88);\r\n  backdrop-filter: blur(12px);\r\n  border-radius: 16px;\r\n}\r\n\r\n.hero-label strong {\r\n  display: block;\r\n  color: var(--cream);\r\n  margin-bottom: 4px;\r\n  font-size: 16px;\r\n}\r\n\r\n.hero-label p {\r\n  color: var(--muted);\r\n  font-size: 13px;\r\n}\r\n\r\n/* INTRODUCTION */\r\n\r\n.intro-grid {\r\n  display: grid;\r\n  grid-template-columns: 0.9fr 1.1fr;\r\n  gap: 75px;\r\n  align-items: start;\r\n}\r\n\r\n.intro-panel {\r\n  padding: 32px;\r\n  background: linear-gradient(\r\n    135deg,\r\n    #172b23,\r\n    #101d19\r\n  );\r\n  border: 1px solid var(--border);\r\n  border-radius: 22px;\r\n}\r\n\r\n.intro-panel .big-plus {\r\n  width: 55px;\r\n  height: 55px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: rgba(16,201,130,0.12);\r\n  border-radius: 15px;\r\n  color: var(--green);\r\n  font-size: 35px;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.intro-panel h3 {\r\n  font-size: 24px;\r\n  color: var(--cream);\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.intro-panel p,\r\n.intro-copy p {\r\n  color: var(--muted);\r\n  font-size: 15px;\r\n}\r\n\r\n.intro-copy p + p {\r\n  margin-top: 17px;\r\n}\r\n\r\n.intro-copy .section-title {\r\n  max-width: 530px;\r\n}\r\n\r\n/* MISSION AND VALUES */\r\n\r\n.values-section {\r\n  background: #0e1b17;\r\n  border-top: 1px solid var(--border);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.center-heading {\r\n  text-align: center;\r\n  margin-bottom: 48px;\r\n}\r\n\r\n.center-heading .section-description {\r\n  margin: 0 auto;\r\n}\r\n\r\n.values-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 22px;\r\n}\r\n\r\n.value-card {\r\n  padding: 30px 26px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 20px;\r\n  transition: transform 0.25s, border-color 0.25s;\r\n}\r\n\r\n.value-card:hover {\r\n  transform: translateY(-5px);\r\n  border-color: rgba(16,201,130,0.5);\r\n}\r\n\r\n.value-icon {\r\n  display: grid;\r\n  place-items: center;\r\n  width: 52px;\r\n  height: 52px;\r\n  background: rgba(16,201,130,0.12);\r\n  color: var(--green-light);\r\n  border-radius: 15px;\r\n  font-size: 25px;\r\n  margin-bottom: 21px;\r\n}\r\n\r\n.value-card h3 {\r\n  font-size: 19px;\r\n  color: var(--cream);\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.value-card p {\r\n  font-size: 14px;\r\n  color: var(--muted);\r\n}\r\n\r\n/* PRODUCT CATEGORIES */\r\n\r\n.categories-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 18px;\r\n  margin-top: 38px;\r\n}\r\n\r\n.category-card {\r\n  min-height: 210px;\r\n  padding: 25px 20px;\r\n  border-radius: 18px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  transition: 0.25s ease;\r\n}\r\n\r\n.category-card:hover {\r\n  border-color: var(--green);\r\n  background: var(--surface-light);\r\n  transform: translateY(-4px);\r\n}\r\n\r\n.category-symbol {\r\n  color: var(--green-light);\r\n  font-size: 32px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.category-card h3 {\r\n  font-size: 17px;\r\n  color: var(--cream);\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.category-card p {\r\n  font-size: 13px;\r\n  color: var(--muted);\r\n}\r\n\r\n/* CUSTOMER CARE */\r\n\r\n.care-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 60px;\r\n  align-items: center;\r\n}\r\n\r\n.care-visual {\r\n  min-height: 360px;\r\n  border-radius: 24px;\r\n  overflow: hidden;\r\n  background:\r\n    linear-gradient(\r\n      180deg,\r\n      rgba(11,21,19,0.02),\r\n      rgba(11,21,19,0.6)\r\n    ),\r\n    url(\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1000&q=85\")\r\n    center / cover no-repeat,\r\n    #1b3529;\r\n}\r\n\r\n.care-list {\r\n  list-style: none;\r\n  margin-top: 25px;\r\n}\r\n\r\n.care-list li {\r\n  display: flex;\r\n  gap: 13px;\r\n  align-items: flex-start;\r\n  margin-bottom: 17px;\r\n  color: var(--muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.care-list li span {\r\n  color: var(--green);\r\n  font-weight: bold;\r\n}\r\n\r\n/* CALL TO ACTION */\r\n\r\n.cta-section {\r\n  padding: 40px 0 90px;\r\n}\r\n\r\n.cta-panel {\r\n  text-align: center;\r\n  padding: 60px 30px;\r\n  border: 1px solid rgba(16,201,130,0.25);\r\n  border-radius: 28px;\r\n  background:\r\n    radial-gradient(\r\n      ellipse at top,\r\n      rgba(16,201,130,0.15),\r\n      transparent 65%\r\n    ),\r\n    #111f1b;\r\n}\r\n\r\n.cta-panel h2 {\r\n  font-size: clamp(30px, 4vw, 43px);\r\n  line-height: 1.2;\r\n  color: var(--cream);\r\n  margin-bottom: 17px;\r\n}\r\n\r\n.cta-panel p {\r\n  max-width: 600px;\r\n  margin: 0 auto 26px;\r\n  color: var(--muted);\r\n  font-size: 15px;\r\n}\r\n\r\n/* FOOTER */\r\n\r\n.site-footer {\r\n  padding: 45px 0 22px;\r\n  background: #080f0d;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.footer-main {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 35px;\r\n  flex-wrap: wrap;\r\n  padding-bottom: 30px;\r\n}\r\n\r\n.footer-about {\r\n  max-width: 340px;\r\n}\r\n\r\n.footer-about p {\r\n  margin-top: 15px;\r\n  color: var(--muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.footer-heading {\r\n  font-size: 14px;\r\n  color: var(--cream);\r\n  margin-bottom: 13px;\r\n}\r\n\r\n.footer-links {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.footer-links a {\r\n  font-size: 13px;\r\n  color: var(--muted);\r\n}\r\n\r\n.footer-links a:hover {\r\n  color: var(--green-light);\r\n}\r\n\r\n.footer-bottom {\r\n  padding-top: 20px;\r\n  border-top: 1px solid var(--border);\r\n  color: #899a91;\r\n  font-size: 12px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n/* RESPONSIVE DESIGN */\r\n\r\n@media (max-width: 1050px) {\r\n  .hero-grid {\r\n    gap: 35px;\r\n  }\r\n\r\n  .categories-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 800px) {\r\n  .section {\r\n    padding: 65px 0;\r\n  }\r\n\r\n  .about-hero {\r\n    padding: 65px 0;\r\n  }\r\n\r\n  .hero-grid,\r\n  .intro-grid,\r\n  .care-grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 35px;\r\n  }\r\n\r\n  .hero-copy h1 {\r\n    font-size: clamp(42px, 9vw, 58px);\r\n  }\r\n\r\n  .hero-visual {\r\n    min-height: 350px;\r\n  }\r\n\r\n  .intro-panel {\r\n    padding: 25px;\r\n  }\r\n\r\n  .values-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .care-visual {\r\n    min-height: 300px;\r\n  }\r\n\r\n  .cta-panel {\r\n    padding: 45px 22px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .container {\r\n    width: 90%;\r\n  }\r\n\r\n  .hero-copy h1 {\r\n    font-size: 42px;\r\n    letter-spacing: -1.5px;\r\n  }\r\n\r\n  .hero-copy p {\r\n    font-size: 14px;\r\n  }\r\n\r\n  .hero-visual {\r\n    min-height: 290px;\r\n    border-radius: 20px;\r\n  }\r\n\r\n  .categories-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .category-card {\r\n    min-height: 170px;\r\n  }\r\n\r\n  .footer-main {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .footer-bottom {\r\n    flex-direction: column;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  html {\r\n    scroll-behavior: auto;\r\n  }\r\n\r\n  *,\r\n  *::before,\r\n  *::after {\r\n    transition-duration: 0.01ms !important;\r\n  }\r\n}\r\n</style>\r\n\r\n<main>\r\n\r\n  <!-- ABOUT HERO -->\r\n  <section data-bs-version=\"5.1\" class=\"about-hero\">\r\n    <div class=\"container hero-grid\">\r\n\r\n      <div class=\"hero-copy\">\r\n        <span class=\"eyebrow\">GET TO KNOW REGKINGS</span>\r\n\r\n        <h1>\r\n          Your Health.<br>\r\n          Our <span>Priority.</span>\r\n        </h1>\r\n\r\n        <p>\r\n          Welcome to RegKings Patent &amp; Cosmetic Stores,\r\n          your destination for healthcare essentials, patent\r\n          medicine products, skincare and beauty items.\r\n          We are committed to helping our customers find\r\n          products that suit their everyday needs.\r\n        </p>\r\n\r\n        <div class=\"hero-actions\">\r\n          <a href=\"pharmacy.html\" class=\"btn btn-primary\">\r\n            Explore Products →\r\n          </a>\r\n\r\n          <a href=\"#our-story\" class=\"btn btn-outline\">\r\n            Our Story\r\n          </a>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"hero-visual\" role=\"img\" aria-label=\"Skincare and personal care products\">\r\n        <div class=\"hero-label\">\r\n          <strong>Health. Beauty. Wellness.</strong>\r\n          <p>Care you can count on.</p>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- OUR STORY -->\r\n  <section class=\"section\" id=\"our-story\">\r\n    <div class=\"container intro-grid\">\r\n\r\n      <div class=\"intro-panel\">\r\n        <div class=\"big-plus\">+</div>\r\n\r\n        <span class=\"eyebrow\">WHO WE ARE</span>\r\n\r\n        <h3>More Than Products. A Commitment to Care.</h3>\r\n\r\n        <p>\r\n          At RegKings Patent &amp; Cosmetic Stores, we believe\r\n          that shopping for healthcare and beauty essentials\r\n          should be a straightforward and welcoming experience.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"intro-copy\">\r\n        <span class=\"eyebrow\">OUR STORY</span>\r\n\r\n        <h2 class=\"section-title\">\r\n          Helping You Care for Yourself, Every Day.\r\n        </h2>\r\n\r\n        <p>\r\n          RegKings Patent &amp; Cosmetic Stores brings together\r\n          everyday healthcare essentials, skincare, cosmetics\r\n          and personal-care products in one convenient place.\r\n        </p>\r\n\r\n        <p>\r\n          We aim to provide a welcoming shopping experience,\r\n          helpful customer service and access to products that\r\n          support everyday personal care and wellbeing.\r\n        </p>\r\n\r\n        <p>\r\n          Whether you are looking for beauty essentials or\r\n          healthcare products, our goal is to help you shop\r\n          with confidence and receive respectful service.\r\n        </p>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- MISSION AND VALUES -->\r\n  <section class=\"section values-section\">\r\n    <div class=\"container\">\r\n\r\n      <div class=\"center-heading\">\r\n        <span class=\"eyebrow\">WHAT GUIDES US</span>\r\n        <h2 class=\"section-title\">Our Mission &amp; Values</h2>\r\n\r\n        <p class=\"section-description\">\r\n          The principles behind the way we serve our customers\r\n          and approach healthcare, beauty and personal care.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"values-grid\">\r\n\r\n        <article class=\"value-card\">\r\n          <div class=\"value-icon\" aria-hidden=\"true\">✚</div>\r\n          <h3>Customer Care</h3>\r\n          <p>\r\n            We strive to treat every customer with respect,\r\n            provide helpful service and make every visit\r\n            a welcoming experience.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"value-card\">\r\n          <div class=\"value-icon\" aria-hidden=\"true\">✦</div>\r\n          <h3>Quality &amp; Trust</h3>\r\n          <p>\r\n            We aim to offer genuine products sourced through\r\n            appropriate channels and help customers make\r\n            informed purchasing decisions.\r\n          </p>\r\n        </article>\r\n\r\n        <article class=\"value-card\">\r\n          <div class=\"value-icon\" aria-hidden=\"true\">♡</div>\r\n          <h3>Responsible Care</h3>\r\n          <p>\r\n            We value responsible medicine sales, appropriate\r\n            guidance and the wellbeing of the people\r\n            who trust our store.\r\n          </p>\r\n        </article>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- WHAT WE OFFER -->\r\n  <section class=\"section\" id=\"what-we-offer\">\r\n    <div class=\"container\">\r\n\r\n      <span class=\"eyebrow\">EXPLORE OUR RANGE</span>\r\n\r\n      <h2 class=\"section-title\">\r\n        Products for Your Everyday Needs.\r\n      </h2>\r\n\r\n      <p class=\"section-description\">\r\n        Discover our range of healthcare and personal-care\r\n        categories. Availability may vary by store.\r\n      </p>\r\n\r\n      <div class=\"categories-grid\">\r\n\r\n        <a href=\"pharmacy.html\" class=\"category-card\">\r\n          <div>\r\n            <div class=\"category-symbol\" aria-hidden=\"true\">✚</div>\r\n            <h3>Pharmacy</h3>\r\n            <p>\r\n              Explore available healthcare essentials\r\n              and pharmacy-related products.\r\n            </p>\r\n          </div>\r\n        </a>\r\n\r\n        <a href=\"patents.html\" class=\"category-card\">\r\n          <div>\r\n            <div class=\"category-symbol\" aria-hidden=\"true\">＋</div>\r\n            <h3>Patent Medicine</h3>\r\n            <p>\r\n              Learn about available patent medicine\r\n              products and responsible purchasing.\r\n            </p>\r\n          </div>\r\n        </a>\r\n\r\n        <a href=\"cosmetics.html\" class=\"category-card\">\r\n          <div>\r\n            <div class=\"category-symbol\" aria-hidden=\"true\">✧</div>\r\n            <h3>Cosmetics &amp; Skincare</h3>\r\n            <p>\r\n              Discover beauty, skincare and\r\n              personal-care essentials.\r\n            </p>\r\n          </div>\r\n        </a>\r\n\r\n        <a href=\"pharmacy.html\" class=\"category-card\">\r\n          <div>\r\n            <div class=\"category-symbol\" aria-hidden=\"true\">◇</div>\r\n            <h3>Everyday Essentials</h3>\r\n            <p>\r\n              Browse other personal-care and\r\n              wellness products available in store.\r\n            </p>\r\n          </div>\r\n        </a>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CUSTOMER CARE -->\r\n  <section class=\"section values-section\">\r\n    <div class=\"container care-grid\">\r\n\r\n      <div class=\"care-visual\" role=\"img\" aria-label=\"Healthcare professional in a clinical setting\">\r\n      </div>\r\n\r\n      <div>\r\n        <span class=\"eyebrow\">OUR COMMITMENT</span>\r\n\r\n        <h2 class=\"section-title\">\r\n          Care That Puts People First.\r\n        </h2>\r\n\r\n        <p class=\"section-description\">\r\n          We want every customer to feel welcome, informed\r\n          and respected when shopping with RegKings.\r\n        </p>\r\n\r\n        <ul class=\"care-list\">\r\n          <li>\r\n            <span>✓</span>\r\n            <div>\r\n              <strong>Helpful service</strong><br>\r\n              We aim to make your shopping experience\r\n              clear, friendly and convenient.\r\n            </div>\r\n          </li>\r\n\r\n          <li>\r\n            <span>✓</span>\r\n            <div>\r\n              <strong>Responsible medicine sales</strong><br>\r\n              Medicines should be supplied and used\r\n              responsibly, with appropriate professional\r\n              guidance when needed.\r\n            </div>\r\n          </li>\r\n\r\n          <li>\r\n            <span>✓</span>\r\n            <div>\r\n              <strong>Customer confidence</strong><br>\r\n              We aim to help customers understand product\r\n              information and make informed choices.\r\n            </div>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CALL TO ACTION -->\r\n  <section class=\"cta-section\" id=\"visit-us\">\r\n    <div class=\"container\">\r\n      <div class=\"cta-panel\">\r\n\r\n        <span class=\"eyebrow\">WE WOULD LOVE TO SERVE YOU</span>\r\n\r\n        <h2>\r\n          Your Health. Your Beauty.<br>\r\n          Your Everyday Essentials.\r\n        </h2>\r\n\r\n        <p>\r\n          Explore our products or get in touch with RegKings\r\n          Patent &amp; Cosmetic Stores to learn more about\r\n          what we offer.\r\n        </p>\r\n\r\n        <div class=\"hero-actions\" style=\"justify-content:center;\">\r\n          <a href=\"patents.html\" class=\"btn btn-primary\">\r\n            Browse Products →\r\n          </a>\r\n\r\n          <a href=\"contact.html\" class=\"btn btn-outline\">\r\n            Contact Us\r\n          </a>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n</main>\r\n\r\n<!-- FOOTER -->\r\n<footer class=\"site-footer\">\r\n  <div class=\"container\">\r\n\r\n    <div class=\"footer-main\">\r\n\r\n      <div class=\"footer-about\">\r\n        <a class=\"brand\" href=\"index.html\">\r\n          <div class=\"brand-icon\">+</div>\r\n          <div>\r\n            <div class=\"brand-name\">\r\n              Reg<span>Kings</span>\r\n            </div>\r\n            <div class=\"brand-caption\">\r\n              Patent &amp; Cosmetic Stores\r\n            </div>\r\n          </div>\r\n        </a>\r\n\r\n        <p>\r\n          Healthcare essentials, skincare and beauty\r\n          products for your everyday needs.\r\n        </p>\r\n      </div>\r\n\r\n      <div>\r\n        <h3 class=\"footer-heading\">Quick Links</h3>\r\n        <div class=\"footer-links\">\r\n          <a href=\"index.html\">Home</a>\r\n          <a href=\"about.html\">About Us</a>\r\n          <a href=\"contact.html\">Contact</a>\r\n        </div>\r\n      </div>\r\n\r\n      <div>\r\n        <h3 class=\"footer-heading\">Our Categories</h3>\r\n        <div class=\"footer-links\">\r\n          <a href=\"pharmacy.html\">Pharmacy</a>\r\n          <a href=\"patents.html\">Patents</a>\r\n          <a href=\"cosmetics.html\">Cosmetics</a>\r\n          <a href=\"stores.html\">Visit Our Stores</a>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n\r\n    <div class=\"footer-bottom\">\r\n      <p>\r\n        © <span id=\"currentYear\"></span>\r\n        RegKings Patent &amp; Cosmetic Stores.\r\n        All rights reserved.\r\n      </p>\r\n      <p>Health. Beauty. Wellness.</p>\r\n    </div>\r\n\r\n  </div>\r\n</footer>\r\n\r\n<script>\r\n/* =========================\r\n   REGKINGS WEBSITE SCRIPT\r\n========================= */\r\n\r\n(function () {\r\n  \"use strict\";\r\n\r\n  // Automatically update the copyright year\r\n  var yearElement = document.getElementById(\"currentYear\");\r\n\r\n  if (yearElement) {\r\n    yearElement.textContent = new Date().getFullYear();\r\n  }\r\n\r\n})();\r\n</script>\r\n",
          "_cid": "GG6RepFzS8",
          "_anchor": "header09-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "index.html": {
      "settings": {
        "main": true,
        "title": "Home",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "z-index": "1000",
            "width": "100%",
            "position": "relative",
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            "@media (max-width: 767px)": {
              ".navbar-toggler": {
                "transform": "scale(0.8)"
              }
            },
            ".navbar-brand": {
              "img": {
                "max-width": "100%",
                "max-height": "100%",
                "border-radius": "0px !important"
              },
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".navbar-nav": {
              "margin": "auto",
              "margin-left": "0",
              "& when (@contentAlign = \"2\")": {
                "margin-left": "auto"
              },
              "& when (@contentAlign = \"3\")": {
                "margin-left": "auto",
                "margin-right": "0"
              },
              ".nav-item": {
                "padding": "0 !important",
                "transition": "0.3s all !important",
                ".nav-link": {
                  "padding": "16px !important",
                  "margin": "0 !important",
                  "border-radius": "1rem !important",
                  "transition": "0.3s all !important",
                  "&:hover": {
                    "background-color": "rgba(27, 31, 10, 0.06)"
                  },
                  "& when not (@isRoundedButtons)": {
                    "border-radius": "4px !important"
                  }
                }
              },
              ".open": {
                ".nav-link": {
                  "&::after": {
                    "transform": "rotate(180deg)"
                  },
                  "@media (min-width: 992px)": {
                    "&::before": {
                      "content": "\"\"",
                      "width": "100%",
                      "height": "20px",
                      "top": "100%",
                      "background": "transparent",
                      "position": "absolute"
                    }
                  }
                }
              },
              ".dropdown-item": {
                "padding": "12px !important",
                "border-radius": "0.5rem !important",
                "margin": "0 8px !important",
                "transition": "0.3s all !important",
                "&:hover": {
                  "background-color": "rgba(27, 31, 10, 0.06)"
                },
                "& when not (@isRoundedButtons)": {
                  "border-radius": "4px !important"
                }
              },
              "& when not (@showLogo), (@showBrand)": {
                "@media (min-width: 992px)": {
                  "padding-left": "1.5rem"
                }
              },
              "& when not (@showBrand)": {
                "@media (min-width: 992px)": {
                  "padding-left": "1.5rem"
                }
              }
            },
            ".nav-link": {
              "width": "fit-content",
              "position": "relative"
            },
            ".navbar-logo": {
              "padding-left": "2rem",
              "margin": "0 !important",
              "@media (max-width: 767px)": {
                "padding-left": "1rem"
              }
            },
            ".navbar-caption": {
              "padding-left": "1rem",
              "padding-right": "0.5rem",
              "& when not (@showLogo)": {
                "@media (min-width: 767px)": {
                  "padding-left": "2rem"
                }
              }
            },
            ".nav-dropdown": {
              "@media (max-width: 767px)": {
                "padding-bottom": "0.5rem"
              }
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem",
              "transition": "0.3s all"
            },
            ".container": {
              "display": "flex",
              "height": "90px",
              "padding": "0.5rem 0.6rem",
              "flex-wrap": "nowrap",
              "left": "0",
              "right": "0",
              "-webkit-box-pack": "justify",
              "-ms-flex-pack": "justify",
              "justify-content": "flex-end",
              "-webkit-box-align": "center",
              "-webkit-align-items": "center",
              "-ms-flex-align": "center",
              "align-items": "center",
              "border-radius": "100vw",
              "@media (max-width: 992px)": {
                "padding-right": "2rem"
              },
              "@media (max-width: 767px)": {
                "width": "95%",
                "height": "56px !important",
                "padding-right": "1rem",
                "margin-top": "0rem"
              },
              "& when not (@isRoundedButtons)": {
                "border-radius": "4px !important"
              }
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "padding-right": "0.5rem"
            },
            ".dropdown-menu": {
              "flex-wrap": "wrap",
              "flex-direction": "column",
              "max-width": "100%",
              "padding": "12px 4px !important",
              "border-radius": "1.5rem",
              "transition": "0.3s all !important",
              "min-width": "auto",
              "background": "@menuBgColor",
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
              },
              "& when not (@isRoundedButtons)": {
                "border-radius": "4px !important"
              }
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "90px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "background": "transparent !important",
              "&:not(.navbar-short)": {},
              "&.opened": {
                "transition": "all 0.25s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 1.8rem"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              ".navbar-collapse": {
                "z-index": "1",
                "justify-content": "flex-end"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
